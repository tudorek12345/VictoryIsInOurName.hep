+    #[test]
+    fn two_requested_workers_leave_capacity_beside_a_slow_prewarm() {
+        // A 16-thread CPU defaults to ten workers, but the launcher's
+        // explicit two-worker profile must admit only one slow prewarm.
+        let limit = slow_worker_count(worker_count(Some(2), 16));
+        let (first, second, requested) = (
+            Arc::new(Pending::new(Vec::new(), None)),
+            Arc::new(Pending::new(Vec::new(), None)),
+            Arc::new(Pending::new(Vec::new(), None)),
+        );
+        let mut queue = Queue::new();
+        queue.push_as(&first, EARLY, true);
+        queue.push_as(&second, EARLY, true);
+        assert!(Arc::ptr_eq(&queue.pop(false, limit).unwrap(), &first));
+        assert!(queue.pop(false, limit).is_none());
+
+        // Work requested by a draw still takes the remaining worker.
+        queue.push_as(&requested, REQUESTED, true);
+        assert!(Arc::ptr_eq(&queue.pop(false, limit).unwrap(), &requested));
+        assert!(!requested.was_slow.load(Ordering::Relaxed));
+        assert!(queue.pop(false, limit).is_none());
+        queue.slow_now -= 1;
+        assert!(Arc::ptr_eq(&queue.pop(false, limit).unwrap(), &second));
+    }
