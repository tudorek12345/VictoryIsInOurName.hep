+/// Use the same general-worker budget for startup and speculative slow
+/// work. Deriving the slow quota from the CPU default could occupy both
+/// workers when the user explicitly requested only two.
+fn configured_worker_count() -> usize {
+    worker_count(
+        std::env::var("VICTORY_PIPELINE_WORKERS")
+            .ok()
+            .and_then(|v| v.trim().parse().ok()),
+        std::thread::available_parallelism().map_or(2, |n| n.get()),
+    )
+}
