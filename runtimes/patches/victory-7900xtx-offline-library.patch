+/// For a single offline compiler child. The parent must serialize children;
+/// independent library writers would overwrite one another's saved entries.
+pub fn use_library(dir: PathBuf) {
+    super::library::use_pipeline_cache(dir);
+}
+
+/// Checkpoints the library without replacing the parent's append-only logs.
+/// A success reports newly created PSOs, library loads and serialized bytes.
+pub fn checkpoint_library() -> Option<(u64, u64, u64)> {
+    use std::sync::atomic::Ordering::Relaxed;
+    super::library::checkpoint_offline().then(|| (
+        super::library::MADE.load(Relaxed),
+        super::library::LOADED.load(Relaxed),
+        super::library::SAVED.load(Relaxed),
+    ))
+}
