+/// A recording's dynamic slots. Owning the original heap avoids looking up
+/// a title heap by a CPU address that may have been freed and reused. This
+/// is deliberately not Clone: only its owner returns the slots, once.
+pub(crate) struct DynamicSlots {
+    heap: std::sync::Arc<HostHeap>,
+    first: u32,
+    count: u32,
+}
+
+impl DynamicSlots {
+    pub(crate) fn first(&self) -> u32 {
+        self.first
+    }
+}
+
+impl Drop for DynamicSlots {
+    fn drop(&mut self) {
+        self.heap.release(self.first, self.count);
+    }
+}
+
+/// Remove only the references owned by live slots being returned. Called
+/// with the allocation lock held, so a slot cannot be reused until its old
+/// reference is detached. The caller retires these resources after unlocking.
+fn take_dynamic_resources<T>(
+    count: u32,
+    first: u32,
+    n: u32,
+    taken: &mut [bool],
+    kept: &[Mutex<Option<T>>],
+) -> (u32, Vec<T>) {
+    let Some(at) = first.checked_sub(count).map(|at| at as usize) else {
+        return (0, Vec::new());
+    };
+    let end = at.saturating_add(n as usize).min(taken.len());
+    let Some(slots) = taken.get_mut(at..end) else {
+        return (0, Vec::new());
+    };
+    let mut given = 0;
+    let mut retired = Vec::new();
+    for (offset, live) in slots.iter_mut().enumerate() {
+        if !*live {
+            continue;
+        }
+        if let Some(slot) = (first as usize).checked_add(offset).and_then(|index| kept.get(index))
+            && let Some(resource) = slot.lock().unwrap_or_else(|e| e.into_inner()).take()
+        {
+            retired.push(resource);
+        }
+        *live = false;
+        given += 1;
+    }
+    (given, retired)
+}
