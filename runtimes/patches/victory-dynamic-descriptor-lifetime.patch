+    #[test]
+    fn dynamic_release_detaches_only_live_resources_and_preserves_retirement_ownership() {
+        use std::sync::Arc;
+
+        // Static, live dynamic, already-free dynamic, live dynamic.
+        let resources: Vec<_> = (0..4).map(Arc::new).collect();
+        let weak: Vec<_> = resources.iter().map(Arc::downgrade).collect();
+        let kept: Vec<_> = resources.into_iter().map(|r| Mutex::new(Some(r))).collect();
+        let mut taken = [true, false, true];
+        let (given, retired) = take_dynamic_resources(1, 1, 3, &mut taken, &kept);
+        assert_eq!(given, 2);
+        assert_eq!(taken, [false; 3]);
+        assert_eq!(retired.iter().map(|r| **r).collect::<Vec<_>>(), [1, 3]);
+        assert!(kept[0].lock().unwrap().is_some());
+        assert!(kept[2].lock().unwrap().is_some());
+        assert!(kept[1].lock().unwrap().is_none());
+        assert!(kept[3].lock().unwrap().is_none());
+        // Returning the slot transfers ownership to retirement; it does
+        // not destroy a resource that the GPU may still reference.
+        assert!(weak.iter().all(|r| r.upgrade().is_some()));
+        drop(retired);
+        assert!(weak[1].upgrade().is_none() && weak[3].upgrade().is_none());
+        assert!(weak[0].upgrade().is_some() && weak[2].upgrade().is_some());
+        // A repeat return neither counts slots twice nor clears a free
+        // slot's unrelated retained resource.
+        let (given, retired) = take_dynamic_resources(1, 1, 3, &mut taken, &kept);
+        assert_eq!(given, 0);
+        assert!(retired.is_empty() && kept[2].lock().unwrap().is_some());
+    }
+
+    #[test]
+    fn dynamic_release_rejects_static_slots_and_bounds_overflowing_ranges() {
+        let kept: Vec<_> = (0..5).map(|i| Mutex::new(Some(i))).collect();
+        let mut taken = [true; 3];
+        for (first, n) in [(1, u32::MAX), (u32::MAX, u32::MAX), (5, 1), (2, 0)] {
+            let (given, retired) = take_dynamic_resources(2, first, n, &mut taken, &kept);
+            assert_eq!(given, 0);
+            assert!(retired.is_empty());
+            assert_eq!(taken, [true; 3]);
+        }
+        let (given, retired) = take_dynamic_resources(2, 3, u32::MAX, &mut taken, &kept);
+        assert_eq!(given, 2);
+        assert_eq!(retired, [3, 4]);
+        assert_eq!(taken, [true, false, false]);
+        assert!(kept[..3].iter().all(|slot| slot.lock().unwrap().is_some()));
+    }
+
+    #[test]
+    fn dynamic_slots_return_to_the_original_heap_and_keep_it_alive() {
+        use std::sync::Arc;
+        use std::sync::atomic::Ordering::Relaxed;
+
+        let old = Arc::new(HostHeap::new(false, 4).expect("host descriptor heap required"));
+        let old_weak = Arc::downgrade(&old);
+        let old_slots = old.dynamic_slots(2).unwrap();
+        let new = Arc::new(HostHeap::new(false, 4).expect("replacement host descriptor heap required"));
+        let new_slots = new.dynamic_slots(2).unwrap();
+        assert_eq!(old_slots.first(), new_slots.first());
+        assert_ne!(old.identity(), new.identity());
+        let new_free = new.free.load(Relaxed);
+        drop(old);
+        // A title heap can disappear while its detached recording waits.
+        assert!(old_weak.upgrade().is_some());
+        drop(old_slots);
+        // No address registry is consulted, and the replacement's live
+        // slots are untouched. No back-reference keeps the old heap alive.
+        assert!(old_weak.upgrade().is_none());
+        assert_eq!(new.free.load(Relaxed), new_free);
+        assert!(new.next.lock().unwrap().1[..2].iter().all(|live| *live));
+        drop(new_slots);
+        assert_eq!(new.free.load(Relaxed), new_free + 2);
+        assert!(new.next.lock().unwrap().1[..2].iter().all(|live| !*live));
+    }
+
+    #[test]
