+    /// Layout after the optimizer's existing reachability and liveness passes.
+    /// Only empty forwarders and latches can disappear here; values and
+    /// effects remain governed by the existing optimizer and writer.
+    fn block_layout(&self, live: &[bool]) -> BlockLayout {
+        // Blocks are laid out in reverse postorder, so every block follows
+        // its forward predecessors (drivers take a branch to an earlier
+        // block for a loop's back edge).
+        let succs = |b: usize| successors(self.blocks[b].term);
+        let mut seen = vec![false; self.blocks.len()];
+        let mut post = Vec::new();
+        let mut stack = vec![(0usize, 0usize)];
+        seen[0] = true;
+        while let Some(top) = stack.last_mut() {
+            let (b, k) = *top;
+            top.1 += 1;
+            match succs(b).get(k) {
+                Some(&s) if !seen[s] => {
+                    seen[s] = true;
+                    stack.push((s, 0));
+                }
+                Some(_) => {}
+                None => {
+                    post.push(b);
+                    stack.pop();
+                }
+            }
+        }
+        post.reverse();
+        let mut pos = vec![u64::MAX; self.blocks.len()];
+        for (n, &b) in post.iter().enumerate() {
+            pos[b] = n as u64;
+        }
+        // Marvisak/VIctory 286a00e9: also fold forward empty blocks,
+        // preserving dedicated critical edges and distinct phi predecessors.
+        let mut preds = vec![Vec::new(); self.blocks.len()];
+        for &b in &post {
+            for &s in succs(b).iter() {
+                preds[s].push(b);
+            }
+        }
+        let mut plan = BlockLayout {
+            layout: Vec::new(),
+            pos: Vec::new(),
+            fold: vec![None; self.blocks.len()],
+        };
+        for &b in &post {
+            let blk = &self.blocks[b];
+            let empty = b != 0 && blk.phis.iter().chain(&blk.body).all(|&i| !live[i as usize]);
+            if let (Some(Term::Br(h)), true, [p]) = (blk.term, empty, &preds[b][..])
+                && plan.to(h) != b
+            {
+                plan.fold[b] = Some((*p, h));
+                let (from, at) = (plan.src(b), plan.to(h));
+                let critical = succs(from).len() > 1 && preds[at].len() > 1 && pos[h] > pos[b];
+                if critical || succs(from).iter().filter(|&&s| plan.to(s) == at).count() != 1 {
+                    plan.fold[b] = None;
+                }
+            }
+        }
+        plan.layout = post.into_iter().filter(|&b| plan.fold[b].is_none()).collect();
+        plan.pos = vec![u64::MAX; self.blocks.len()];
+        for (n, &b) in plan.layout.iter().enumerate() {
+            plan.pos[b] = n as u64;
+        }
+        plan
+    }
