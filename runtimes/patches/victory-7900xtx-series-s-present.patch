diff --git a/crates/victory-gpu/src/queue/menu_picture.rs b/crates/victory-gpu/src/queue/menu_picture.rs
new file mode 100644
index 0000000..6ed07c1
--- /dev/null
+++ b/crates/victory-gpu/src/queue/menu_picture.rs
@@ -0,0 +1,226 @@
+//! Series S menu experiment adapted from tudorek12345/VictoryIsInOurName.hep
+//! commits 648e3a933167410f531bf8211eb564fee33c9d6d (draw evidence)
+//! and 260200067d00cac87d6b033323006d85a9562510 (plane layout).
+//! Selection stays on the synchronous path until the async queue carries
+//! draw evidence to its ordered Present job.
+
+use std::sync::{Arc, Mutex, Once, OnceLock};
+
+use windows::Win32::Graphics::Direct3D12::{D3D12_RESOURCE_DIMENSION_TEXTURE2D, ID3D12Resource};
+use windows::Win32::Graphics::Dxgi::Common::{
+    DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709, DXGI_FORMAT_R8G8B8A8_UNORM,
+};
+
+use super::{Plane, This};
+use crate::host::HostList;
+use crate::resource::HostTexture;
+
+#[derive(Clone)]
+pub(crate) struct MenuTarget {
+    pub(super) resource: usize,
+    pub(crate) copy: Arc<HostTexture>,
+    size: (u64, u32),
+}
+
+pub(super) struct Targets<T> {
+    candidate: Option<(u64, T)>,
+    keep_primary: bool,
+}
+
+impl<T> Targets<T> {
+    const fn new() -> Self {
+        Self {
+            candidate: None,
+            keep_primary: false,
+        }
+    }
+
+    fn note(&mut self, size: (u64, u32), serial: u64, target: T) {
+        match size {
+            (1920, 1080) => self.keep_primary = true,
+            (3840, 2160) => match &self.candidate {
+                None => self.candidate = Some((serial, target)),
+                Some((first, _)) if *first != serial => self.keep_primary = true,
+                _ => {}
+            },
+            _ => {}
+        }
+    }
+
+    fn choose(self, overlay: Option<u64>) -> Option<T> {
+        self.candidate
+            .filter(|(serial, _)| {
+                !self.keep_primary && overlay.is_none_or(|overlay| overlay == *serial)
+            })
+            .map(|(_, target)| target)
+    }
+}
+
+static TARGETS: Mutex<Targets<MenuTarget>> = Mutex::new(Targets::new());
+
+fn requested() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        crate::console::current() == crate::console::Console::SeriesS
+            && std::env::var_os("VICTORY_SERIES_S_MENU_PICTURE").is_some_and(|v| v == "1")
+    })
+}
+
+fn synchronous() -> bool {
+    !crate::host::late() && !super::behind::on()
+}
+
+fn size(texture: &ID3D12Resource) -> Option<(u64, u32)> {
+    // SAFETY: a live host texture.
+    let desc = unsafe { texture.GetDesc() };
+    (desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM
+        && desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D
+        && desc.SampleDesc.Count == 1
+        && desc.DepthOrArraySize == 1
+        && desc.MipLevels == 1)
+        .then_some((desc.Width, desc.Height))
+}
+
+/// Records a nonempty host draw's render targets once per list.
+pub(crate) fn note(list: &HostList, resources: &[usize]) {
+    if !requested() || !synchronous() {
+        return;
+    }
+    for &resource in resources {
+        // A diagnostic should not allocate a texture that the draw didn't use.
+        let Some(copy) = crate::resource::made_copy(resource as This) else {
+            continue;
+        };
+        let Some(size @ ((1920, 1080) | (3840, 2160))) = size(&copy.texture) else {
+            continue;
+        };
+        list.note_series_s_target(MenuTarget {
+            resource,
+            copy,
+            size,
+        });
+    }
+}
+
+/// Includes the targets in this present interval once the host fence completes.
+pub(crate) fn submitted(lists: &[&HostList], completed: bool) {
+    if !requested() || !synchronous() {
+        return;
+    }
+    let mut targets = super::lock(&TARGETS);
+    if !completed {
+        targets.keep_primary = true;
+        return;
+    }
+    for list in lists {
+        list.visit_series_s_targets(|target| {
+            targets.note(target.size, target.copy.serial, target.clone());
+        });
+    }
+}
+
+/// Takes the host draws submitted since the preceding PresentX call.
+pub(super) fn take() -> Option<Targets<MenuTarget>> {
+    if !requested() {
+        return None;
+    }
+    let targets = std::mem::replace(&mut *super::lock(&TARGETS), Targets::new());
+    if !synchronous() {
+        static ONCE: Once = Once::new();
+        ONCE.call_once(|| {
+            tracing::info!("Series S menu selection requires synchronous GPU submissions")
+        });
+        return None;
+    }
+    Some(targets)
+}
+
+pub(super) fn select(
+    targets: Option<Targets<MenuTarget>>,
+    planes: u32,
+    parameters: *const Plane,
+    first: &Plane,
+    primary: &ID3D12Resource,
+    frame: u64,
+) -> Option<MenuTarget> {
+    let targets = targets?;
+    if planes != 2 {
+        return None;
+    }
+    const SDR: u32 = DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709.0 as u32;
+    // SAFETY: PresentX supplied exactly two complete plane records.
+    let overlay = unsafe { &*parameters.add(1) };
+    let primary_size = size(primary);
+    static PLANES_REPORTED: Once = Once::new();
+    PLANES_REPORTED.call_once(|| {
+        tracing::info!(
+            frame,
+            ?primary_size,
+            primary_count = first.count,
+            overlay_count = overlay.count,
+            primary_color_space = first.color_space,
+            overlay_color_space = overlay.color_space,
+            has_4k_draw = targets.candidate.is_some(),
+            keep_primary = targets.keep_primary,
+            "Series S two-plane present"
+        );
+    });
+    if first.count != 1
+        || primary_size != Some((1920, 1080))
+        || first.color_space != SDR
+        || overlay.color_space != SDR
+        || overlay.count > 1
+    {
+        return None;
+    }
+    let overlay = if overlay.count == 1 && !overlay.resources.is_null() {
+        // SAFETY: the overlay plane lists one resource.
+        let resource = unsafe { *overlay.resources };
+        crate::resource::made_copy(resource).map(|copy| copy.serial)
+    } else {
+        None
+    };
+    let menu = targets.choose(overlay)?;
+    static REPORTED: Once = Once::new();
+    REPORTED.call_once(|| {
+        tracing::info!(
+            frame,
+            named_by_plane = overlay.is_some(),
+            source_width = 3840,
+            source_height = 2160,
+            "presenting the submitted Series S menu target"
+        );
+    });
+    Some(menu)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::Targets;
+
+    #[test]
+    fn selects_only_a_unique_submitted_4k_target() {
+        let mut targets = Targets::new();
+        targets.note((3840, 2160), 4, 1);
+        targets.note((3840, 2160), 4, 2);
+        assert_eq!(targets.choose(Some(4)), Some(1));
+
+        let mut targets = Targets::new();
+        targets.note((3840, 2160), 4, 1);
+        assert_eq!(targets.choose(None), Some(1));
+
+        let mut targets = Targets::new();
+        targets.note((3840, 2160), 4, 1);
+        assert_eq!(targets.choose(Some(5)), None);
+
+        let mut targets = Targets::new();
+        targets.note((3840, 2160), 4, 1);
+        targets.note((3840, 2160), 5, 2);
+        assert_eq!(targets.choose(Some(4)), None);
+
+        let mut targets = Targets::new();
+        targets.note((3840, 2160), 4, 1);
+        targets.note((1920, 1080), 5, 2);
+        assert_eq!(targets.choose(Some(4)), None);
+    }
+}
