+/// Every how many memory lines (one each 5 s) the address space is walked
+/// for the memory map line ([`log_memory_map`]): `VICTORY_MEMORY_MAP=<n>`,
+/// 60 if unset (about every 5 minutes; 6 before), `0` leaves the walk out.
+/// (This module is in diagnostics builds only.)
+///
+/// The walk asks Windows about every region and holds the process's memory
+/// map while each query runs. The submitting thread's write-watch queries
+/// and the title's faults can wait behind it, so keep the walk infrequent.
+fn memory_map() -> u64 {
+    static EVERY: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    *EVERY.get_or_init(|| memory_map_every(std::env::var("VICTORY_MEMORY_MAP").ok().as_deref()))
+}
+
+fn memory_map_every(value: Option<&str>) -> u64 {
+    value.and_then(|v| v.trim().parse().ok()).unwrap_or(60)
+}
+
+#[cfg(test)]
+mod memory_map_tests {
+    #[test]
+    fn memory_map_interval_is_configurable_and_can_be_disabled() {
+        use super::memory_map_every;
+        assert_eq!(memory_map_every(None), 60);
+        assert_eq!(memory_map_every(Some("invalid")), 60);
+        assert_eq!(memory_map_every(Some("-1")), 60);
+        assert_eq!(memory_map_every(Some("0")), 0);
+        assert_eq!(memory_map_every(Some(" 6 ")), 6);
+    }
 }
 
