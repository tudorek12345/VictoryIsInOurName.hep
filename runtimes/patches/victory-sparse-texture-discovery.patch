 crates/victory-gpu/src/descriptor/host.rs |  99 ++++++++++++++++++---
 crates/victory-gpu/src/host.rs            |   2 +-
 crates/victory-gpu/src/texture.rs         | 101 ++++++++++++++++++++--
 3 files changed, 179 insertions(+), 23 deletions(-)

diff --git a/crates/victory-gpu/src/descriptor/host.rs b/crates/victory-gpu/src/descriptor/host.rs
index e0c528b..a187bdf 100644
--- a/crates/victory-gpu/src/descriptor/host.rs
+++ b/crates/victory-gpu/src/descriptor/host.rs
@@ -869,6 +869,29 @@ pub(crate) fn page_written(at: usize, len: usize) {
 /// texture pass last took the ranges ([`remapped`]).
 static REMAPPED: Mutex<Vec<(u64, u64)>> = Mutex::new(Vec::new());
 
+/// Keep adjacent/overlapping producer notifications together. If a paused
+/// consumer exhausts the bounded queue, a single full-range notification
+/// preserves every invalidation instead of dropping earlier changes.
+/// Adapted from DexNom/VIctory 921d8d3b; the consumer still uses `join`.
+fn record_remap(ranges: &mut Vec<(u64, u64)>, start: u64, end: u64, limit: usize) -> bool {
+    if start >= end {
+        return false;
+    }
+    if let Some(last) = ranges.last_mut()
+        && last.0 <= end && start <= last.1
+    {
+        last.0 = last.0.min(start);
+        last.1 = last.1.max(end);
+    } else if ranges.len() >= limit {
+        ranges.clear();
+        ranges.push((0, u64::MAX));
+        return true;
+    } else {
+        ranges.push((start, end));
+    }
+    false
+}
+
 /// The lowest start and the highest end of any span of [`Spans`] so far
 /// (the start is `u64::MAX` until there is one): what the runtime does to
 /// memory outside is none of the texture pass's business.
@@ -879,7 +902,7 @@ static SPANNED: [std::sync::atomic::AtomicU64; 2] = [
 
 /// Since the start: slots whose view a newer view of other memory there
 /// made stale; ranges of memory noted as mapped, unmapped or written;
-/// ranges dropped because no pass took them; slots made due by such
+/// full-queue rescans; slots made due by such
 /// ranges; and made slots whose memory was found unmapped (made null).
 pub(crate) static STALE: [std::sync::atomic::AtomicU64; 5] =
     [const { std::sync::atomic::AtomicU64::new(0) }; 5];
@@ -914,20 +937,9 @@ pub(crate) fn remapped(at: usize, len: usize) {
     }
     let mut ranges = REMAPPED.lock().unwrap_or_else(|e| e.into_inner());
     STALE[1].fetch_add(1, Relaxed);
-    // Pages are mapped one after the other.
-    if let Some(last) = ranges.last_mut()
-        && last.1 == start
-    {
-        last.1 = end;
-        return;
-    }
-    if ranges.len() >= MOST {
-        // No pass runs (no shader that picks textures by index is bound):
-        // the slots there are looked at when they are due, as before.
-        STALE[2].fetch_add(ranges.len() as u64, Relaxed);
-        ranges.clear();
+    if record_remap(&mut ranges, start, end, MOST) {
+        STALE[2].fetch_add(1, Relaxed);
     }
-    ranges.push((start, end));
 }
 
 /// Ranges of memory, those that touch made one (DexNom/VIctory 921d8d3b:
@@ -5550,6 +5562,65 @@ mod tests {
         assert_eq!(slots(u64::MAX), [2]);
     }
 
+    #[test]
+    fn sparse_texture_remap_producers_merge_overlap_and_adjacency() {
+        let mut ranges = Vec::new();
+        for (start, end) in [(40, 50), (30, 40), (35, 40), (10, 20), (45, 60), (60, 61), (1, 1)] {
+            assert!(!record_remap(&mut ranges, start, end, 3));
+        }
+        join(&mut ranges);
+        assert_eq!(ranges, [(10, 20), (30, 61)]);
+        assert!(!record_remap(&mut ranges, 9, 2, 3));
+        assert_eq!(ranges, [(10, 20), (30, 61)]);
+    }
+
+    #[test]
+    fn sparse_texture_remap_overflow_preserves_all_notifications() {
+        let mut ranges = Vec::new();
+        let changes = [(10, 20), (40, 60), (100, 110), (1, 2), (u64::MAX - 2, u64::MAX)];
+        for (i, &(start, end)) in changes.iter().enumerate() {
+            assert_eq!(record_remap(&mut ranges, start, end, 2), i == 2);
+            assert!(ranges.len() <= 2);
+            for &(old_start, old_end) in &changes[..=i] {
+                assert!(ranges.iter().any(|&(from, to)| from <= old_start && old_end <= to));
+            }
+        }
+        join(&mut ranges);
+        assert_eq!(ranges, [(0, u64::MAX)]);
+        // Draining starts a fresh, bounded batch rather than keeping the
+        // full rescan active forever.
+        let drained = std::mem::take(&mut ranges);
+        assert_eq!(drained, [(0, u64::MAX)]);
+        assert!(!record_remap(&mut ranges, 8, 16, 2));
+        assert_eq!(ranges, [(8, 16)]);
+    }
+
+    #[test]
+    fn sparse_texture_full_rescan_visits_only_registered_slots() {
+        let mut spans = Spans { rule: Rule::Start, ..Default::default() };
+        for (slot, start, end) in [
+            (1, 0, 0x1000),
+            (2, 0x7fee_0000_0000, 0x7fee_0001_0000),
+            (3, 0x7fee_0000_0000, 0x7fee_0001_0000),
+            (4, u64::MAX - 0x10000, u64::MAX),
+        ] {
+            assert!(spans.note(slot, start, end, true).is_empty());
+        }
+        spans.forget(3);
+        let mut ranges = Vec::new();
+        assert!(!record_remap(&mut ranges, 10, 20, 2));
+        assert!(!record_remap(&mut ranges, 40, 50, 2));
+        assert!(record_remap(&mut ranges, 70, 80, 2));
+        // The consumer queries the ordered span index, not every address
+        // in the sentinel. Its output is bounded by registered slots even
+        // with a full-width interval and spans at both address extremes.
+        join(&mut ranges);
+        let mut slots: Vec<_> = ranges.iter().flat_map(|&(start, end)| spans.slots_in(start, end)).collect();
+        slots.sort_unstable();
+        slots.dedup();
+        assert_eq!(slots, [1, 2, 4]);
+    }
+
