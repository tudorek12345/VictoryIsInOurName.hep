+/// Count readable committed bytes without touching pages or clearing a
+/// guard. One query skips an entire reserved/free run, including the
+/// usually empty endpoints of a texture that is streaming in.
+fn mapped_regions(start: usize, end: usize) -> u64 {
+    use windows_sys::Win32::System::Memory::{
+        MEM_COMMIT, MEMORY_BASIC_INFORMATION, PAGE_GUARD, PAGE_NOACCESS, VirtualQuery,
+    };
     let (mut p, mut there) = (start, 0u64);
     while p < end {
         // SAFETY: plain data filled in by the query.
@@ -1746,7 +1759,7 @@ pub(crate) fn mapped_bytes(at: *const u8, len: usize) -> u64 {
         if n == 0 || next <= p {
             break;
         }
-        if info.State == MEM_COMMIT {
+        if info.State == MEM_COMMIT && info.Protect & (PAGE_NOACCESS | PAGE_GUARD) == 0 {
             there += (next - p) as u64;
         }
         p = next;
@@ -1862,6 +1875,78 @@ fn staging(resource: This, copy: &crate::resource::HostTexture, first: u32) -> O
 mod title_memory_tests {
     use super::with_title;
 
+    struct Reservation(*mut u8);
+
+    impl Reservation {
+        fn new(bytes: usize) -> Self {
+            use windows_sys::Win32::System::Memory::*;
+            // SAFETY: reserves private memory; no pages are accessed here.
+            let at = unsafe { VirtualAlloc(std::ptr::null(), bytes, MEM_RESERVE, PAGE_NOACCESS).cast::<u8>() };
+            assert!(!at.is_null());
+            Self(at)
+        }
+    }
+
+    impl Drop for Reservation {
+        fn drop(&mut self) {
+            use windows_sys::Win32::System::Memory::*;
+            // SAFETY: this object owns the whole reservation.
+            unsafe { VirtualFree(self.0.cast(), 0, MEM_RELEASE) };
+        }
+    }
+
+    #[test]
+    fn sparse_texture_interior_pages_are_counted_and_decommit_is_seen() {
+        use windows_sys::Win32::System::Memory::*;
+        const BLOCK: usize = 64 << 10;
+        let reservation = Reservation::new(5 * BLOCK);
+        let base = reservation.0;
+        // SAFETY: only the reservation's interior block is committed; no
+        // raw reads touch the surrounding reserved pages.
+        unsafe {
+            let middle = base.add(2 * BLOCK);
+            assert_eq!(VirtualAlloc(middle.cast(), BLOCK, MEM_COMMIT, PAGE_READWRITE), middle.cast());
+            assert_eq!(super::mapped_bytes(base, 5 * BLOCK), BLOCK as u64);
+            assert_eq!(super::mapped_bytes(base.add(BLOCK - 3), 2 * BLOCK + 9), BLOCK as u64);
+            assert_eq!(super::mapped_bytes(base, 2 * BLOCK), 0);
+            assert_ne!(VirtualFree(middle.cast(), BLOCK, MEM_DECOMMIT), 0);
+            assert_eq!(super::mapped_bytes(base, 5 * BLOCK), 0);
+        }
+    }
+
+    #[test]
+    fn sparse_texture_guard_and_noaccess_pages_stay_unreadable() {
+        use windows_sys::Win32::System::Memory::*;
+        const PAGE: usize = 4096;
+        let reservation = Reservation::new(5 * PAGE);
+        let base = reservation.0;
+        // SAFETY: protects only pages of this reservation. The discovery
+        // query must not read a guard page and clear its one-shot guard.
+        unsafe {
+            let middle = base.add(2 * PAGE);
+            assert_eq!(VirtualAlloc(middle.cast(), PAGE, MEM_COMMIT, PAGE_READWRITE), middle.cast());
+            let mut old = 0;
+            for protection in [PAGE_NOACCESS, PAGE_READWRITE | PAGE_GUARD] {
+                assert_ne!(VirtualProtect(middle.cast(), PAGE, protection, &mut old), 0);
+                assert_eq!(super::mapped_bytes(base, 5 * PAGE), 0);
+                let mut info: MEMORY_BASIC_INFORMATION = std::mem::zeroed();
+                assert_ne!(VirtualQuery(middle.cast(), &mut info, size_of_val(&info)), 0);
+                assert_eq!(info.Protect, protection);
+            }
+            assert_ne!(VirtualProtect(middle.cast(), PAGE, PAGE_READWRITE, &mut old), 0);
+            assert_eq!(super::mapped_bytes(base, 5 * PAGE), PAGE as u64);
+            assert_eq!(super::mapped_regions(middle as usize + 7, middle as usize + PAGE - 5), (PAGE - 12) as u64);
+        }
+    }
+
+    #[test]
+    fn sparse_texture_empty_and_overflowed_ranges_are_empty() {
+        assert_eq!(super::mapped_bytes(std::ptr::null(), 0), 0);
+        assert_eq!(super::mapped_bytes((usize::MAX - 7) as *const u8, 16), 0);
+        assert_eq!(super::mapped_regions(8, 8), 0);
+        assert_eq!(super::mapped_regions(9, 8), 0);
+    }
