+//! Opt-in guest output size, applied before any title code runs.
+//!
+//! Adapted from avatarmanz/VIctory-7900XTX f63b4b12's output-only path.
+//! This changes live settings through the title's screen-size setter, not
+//! merely the host window. Its existing render scale and upscaler remain
+//! unchanged. The back-buffer pool keeps its original capacity.
+//!
+//! Original title bytes are deliberately absent: both the original image
+//! and the mapped ranges are identified by cryptographic digests. A request
+//! is an all-or-error transaction; an error must prevent title execution.
+//! Only the mapped image changes, never the package or cached image file.
+//! The title may subsequently serialize the chosen size to its own settings,
+//! so comparisons should use an isolated fresh profile.
+
+pub const MODES: [(u32, u32); 5] = [
+    (1280, 720),
+    (1664, 936),
+    (1920, 1080),
+    (2560, 1440),
+    (3840, 2160),
+];
+const ORIGINAL_BLAKE3: &str = "b99f876b74d4a77f03af5f878223b27bd647b5c35a79d5decd9f716504239e93";
+const OUTPUT_AT: usize = 0x224352b;
+const OUTPUT_LEN: usize = 61;
+const POOL_AT: usize = 0x247af25;
+const SET_SCREEN_SIZE: usize = 0x2478130;
+const SCREEN_HEIGHT: usize = 0xa9438d0;
+const HEIGHT_CHANGED: usize = 0xd8c3a0;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ApplyOutcome {
+    Disabled,
+    Applied { width: u32, height: u32 },
+}
+
+#[derive(Debug, thiserror::Error)]
+#[error("guest output: {0}")]
+pub struct ResolutionError(String);
+
+fn error(message: impl Into<String>) -> ResolutionError {
+    ResolutionError(message.into())
+}
+
+pub fn parse_output(spec: &str) -> Option<(u32, u32)> {
+    let (w, h) = spec.trim().split_once(['x', 'X'])?;
+    let size = (w.trim().parse().ok()?, h.trim().parse().ok()?);
+    MODES.contains(&size).then_some(size)
+}
+
+struct Patch {
+    at: usize,
+    len: usize,
+    expected: String,
+    write_offset: usize,
+    code: Vec<u8>,
+}
+
+struct Plan {
+    width: u32,
+    height: u32,
+    patches: Vec<Patch>,
+}
+
+fn plan(requested: Option<&str>, original: &str) -> Result<Option<Plan>, ResolutionError> {
+    let Some(spec) = requested else {
+        return Ok(None);
+    };
+    let (width, height) = parse_output(spec).ok_or_else(|| {
+        error("VICTORY_OUTPUT must be 1280x720, 1664x936, 1920x1080, 2560x1440 or 3840x2160")
+    })?;
+    if original != ORIGINAL_BLAKE3 {
+        return Err(error(
+            "VICTORY_OUTPUT does not support this original executable's BLAKE3",
+        ));
+    }
+    Ok(Some(Plan {
+        width,
+        height,
+        patches: vec![
+            Patch {
+                at: OUTPUT_AT,
+                len: OUTPUT_LEN,
+                expected: "f25c4444265c7e41c845ebd73928cab5d62069ebfa4ed6e90a59053d65ab0963".into(),
+                write_offset: 0,
+                code: output_code(width, height),
+            },
+            Patch {
+                at: POOL_AT,
+                len: 9,
+                expected: "a82361972f2771864a7cf22c0b00e9e84aef1572c945d0c5d93dc3a24177f5b2".into(),
+                write_offset: 0,
+                // At lower sizes more unused space is expected. Keep the
+                // unsigned capacity bound and trap, replacing only the
+                // near-full invariant. Native 4K retains its original check.
+                code: if (width, height) == (3840, 2160) {
+                    vec![]
+                } else {
+                    pool_code()
+                },
+            },
+        ],
+    }))
+}
+
+fn rel(to: usize, next: usize) -> [u8; 4] {
+    // All callers use the fixed offsets of this one verified image.
+    i32::try_from(to as i64 - next as i64)
+        .expect("fixed image relative address")
+        .to_le_bytes()
+}
+
+/// Authored replacement: update the settings, call the normal size setter,
+/// and notify the existing height-change handler only when height changed.
+fn output_code(width: u32, height: u32) -> Vec<u8> {
+    let mut code = vec![0xb8]; // mov eax, width
+    code.extend(width.to_le_bytes());
+    code.extend([0x89, 0x86, 0x04, 0x02, 0, 0]); // mov [rsi+204h], eax
+    code.push(0xbf); // mov edi, height
+    code.extend(height.to_le_bytes());
+    code.extend([0x89, 0xbe, 0x08, 0x02, 0, 0]); // mov [rsi+208h], edi
+    code.extend([0x8b, 0x2d]); // mov ebp, [screen height]
+    code.extend(rel(SCREEN_HEIGHT, OUTPUT_AT + code.len() + 4));
+    code.extend([0x89, 0xc1, 0x89, 0xfa, 0xe8]); // arguments; call setter
+    code.extend(rel(SET_SCREEN_SIZE, OUTPUT_AT + code.len() + 4));
+    code.extend([0x39, 0xfd, 0x74, 20]); // cmp ebp, edi; je end
+    code.extend([0xb1, 1, 0xe8]); // mov cl, 1; call height changed
+    code.extend(rel(HEIGHT_CHANGED, OUTPUT_AT + code.len() + 4));
+    code.extend([0xeb, 11]); // jmp end
+    code.resize(OUTPUT_LEN, 0xcc); // unreachable padding
+    code
+}
+
+/// The caller's stack record holds cursor at +0x70 and original capacity
+/// (64/82 MiB) at +0x78. Its allocator callback advances only the cursor and
+/// separately checks each allocation against base+capacity; that code is
+/// unchanged. Here RAX = capacity - (cursor-base), modulo u64. Checking it
+/// against capacity permits unused space while still trapping an overrun
+/// or cursor-before-base. Unlike an unconditional jump, this keeps a bound.
+fn pool_code() -> Vec<u8> {
+    vec![
+        0x48, 0x3b, 0x44, 0x24, 0x78, // cmp rax, [rsp+78h]
+        0x76, 0x02, // jbe original continuation at +9
+        0xcc, // trap if unsigned remaining exceeds capacity
+        0x90, // padding; only reached if a debugger resumes the trap
+    ]
+}
+
+/// Small injected interface makes every transaction failure reproducible
+/// with authored memory; tests never require or execute title code.
+trait Memory {
+    type Protection: Copy;
+    fn read(&mut self, at: usize, len: usize) -> Result<Vec<u8>, String>;
+    fn writable(&mut self, at: usize, len: usize) -> Result<Self::Protection, String>;
+    fn write(&mut self, at: usize, bytes: &[u8]) -> Result<(), String>;
+    fn restore(&mut self, at: usize, len: usize, old: Self::Protection) -> Result<(), String>;
+    fn flush(&mut self, at: usize, len: usize) -> Result<(), String>;
+}
+
+fn range(at: usize, len: usize, size: usize) -> Result<std::ops::Range<usize>, ResolutionError> {
+    let end = at
+        .checked_add(len)
+        .filter(|&end| end <= size)
+        .ok_or_else(|| error("patch range is outside the mapped image"))?;
+    if len == 0 {
+        return Err(error("empty patch range"));
+    }
+    Ok(at..end)
+}
+
+fn transaction<M: Memory>(
+    memory: &mut M,
+    size: usize,
+    patches: &[Patch],
+) -> Result<(), ResolutionError> {
+    let mut backups = Vec::with_capacity(patches.len());
+    // Validate every footprint and digest BEFORE changing any protection.
+    for (i, patch) in patches.iter().enumerate() {
+        let span = range(patch.at, patch.len, size)?;
+        if patch
+            .write_offset
+            .checked_add(patch.code.len())
+            .is_none_or(|end| end > patch.len)
+        {
+            return Err(error("replacement extends outside its verified range"));
+        }
+        if patches[..i]
+            .iter()
+            .any(|p| p.at < span.end && span.start < p.at + p.len)
+        {
+            return Err(error("overlapping patch ranges"));
+        }
+        let bytes = memory.read(patch.at, patch.len).map_err(error)?;
+        if bytes.len() != patch.len || blake3::hash(&bytes).to_hex().as_str() != patch.expected {
+            return Err(error(format!(
+                "mapped bytes differ at +{:#x}; nothing patched",
+                patch.at
+            )));
+        }
+        backups.push(bytes);
+    }
+    let mut protected = Vec::with_capacity(patches.len());
+    for (i, patch) in patches
+        .iter()
+        .enumerate()
+        .filter(|(_, p)| !p.code.is_empty())
+    {
+        match memory.writable(patch.at, patch.len) {
+            Ok(old) => protected.push((i, old)),
+            Err(reason) => {
+                let mut failures = vec![reason];
+                for &(j, old) in protected.iter().rev() {
+                    let p = &patches[j];
+                    if let Err(e) = memory.restore(p.at, p.len, old) {
+                        failures.push(e);
+                    }
+                }
+                return Err(error(failures.join("; ")));
+            }
+        }
+    }
+    let apply = (|| -> Result<(), String> {
+        for &(i, _) in &protected {
+            let p = &patches[i];
+            memory.write(p.at + p.write_offset, &p.code)?;
+        }
+        for &(i, _) in &protected {
+            let p = &patches[i];
+            memory.flush(p.at, p.len)?;
+        }
+        for &(i, old) in protected.iter().rev() {
+            let p = &patches[i];
+            memory.restore(p.at, p.len, old)?;
+        }
+        Ok(())
+    })();
+    if let Err(reason) = apply {
+        // A write can fail after a partial copy in the test backend. Some
+        // pages may already be read-only again. Reacquire each page, restore
+        // its saved bytes, flush, and restore its ORIGINAL protection token.
+        // If the OS also refuses cleanup, report it and still never execute.
+        let mut failures = vec![reason];
+        for &(i, old) in protected.iter().rev() {
+            let p = &patches[i];
+            match memory.writable(p.at, p.len) {
+                Ok(_) => {
+                    if let Err(e) = memory.write(p.at, &backups[i]) {
+                        failures.push(format!("rollback: {e}"));
+                    }
+                    if let Err(e) = memory.flush(p.at, p.len) {
+                        failures.push(format!("rollback: {e}"));
+                    }
+                }
+                Err(e) => failures.push(format!("rollback: {e}")),
+            }
+            if let Err(e) = memory.restore(p.at, p.len, old) {
+                failures.push(format!("rollback: {e}"));
+            }
+        }
+        return Err(error(failures.join("; ")));
+    }
+    Ok(())
+}
+
+#[cfg(windows)]
+struct MappedImage {
+    base: usize,
+    size: usize,
+}
+
+#[cfg(windows)]
+impl MappedImage {
+    fn address(&self, at: usize, len: usize) -> Result<usize, String> {
+        range(at, len, self.size).map_err(|e| e.to_string())?;
+        let address = self.base.checked_add(at).ok_or("image address overflow")?;
+        address.checked_add(len).ok_or("image end overflow")?;
+        Ok(address)
+    }
+
+    fn readable(&self, at: usize, len: usize) -> Result<usize, String> {
+        use windows_sys::Win32::System::Memory::{
+            MEM_COMMIT, MEMORY_BASIC_INFORMATION, PAGE_EXECUTE_READ, PAGE_EXECUTE_READWRITE,
+            PAGE_EXECUTE_WRITECOPY, PAGE_GUARD, VirtualQuery,
+        };
+        let address = self.address(at, len)?;
+        let mut info: MEMORY_BASIC_INFORMATION = unsafe { std::mem::zeroed() };
+        // SAFETY: VirtualQuery inspects the address without dereferencing it.
+        if unsafe { VirtualQuery(address as *const _, &mut info, std::mem::size_of_val(&info)) }
+            == 0
+        {
+            return Err(format!("VirtualQuery: {}", std::io::Error::last_os_error()));
+        }
+        let end = (info.BaseAddress as usize)
+            .checked_add(info.RegionSize)
+            .ok_or("region end overflow")?;
+        if info.State != MEM_COMMIT
+            || info.AllocationBase as usize != self.base
+            || !matches!(
+                info.Protect & 0xff,
+                PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY
+            )
+            || info.Protect & PAGE_GUARD != 0
+            || address + len > end
+        {
+            return Err("patch is not in one readable executable region of this image".into());
+        }
+        Ok(address)
+    }
+}
+
+#[cfg(windows)]
+impl Memory for MappedImage {
+    type Protection = u32;
+    fn read(&mut self, at: usize, len: usize) -> Result<Vec<u8>, String> {
+        let address = self.readable(at, len)?;
+        // SAFETY: committed readable image range checked above; caller keeps
+        // the mapping alive, with no concurrent title execution or mutation.
+        Ok(unsafe { std::slice::from_raw_parts(address as *const u8, len) }.to_vec())
+    }
+    fn writable(&mut self, at: usize, len: usize) -> Result<u32, String> {
+        use windows_sys::Win32::System::Memory::{PAGE_EXECUTE_READWRITE, VirtualProtect};
+        let address = self.readable(at, len)?;
+        let mut old = 0;
+        // SAFETY: one validated executable region, no title execution yet.
+        if unsafe { VirtualProtect(address as *const _, len, PAGE_EXECUTE_READWRITE, &mut old) }
+            == 0
+        {
+            Err(format!(
+                "VirtualProtect writable: {}",
+                std::io::Error::last_os_error()
+            ))
+        } else {
+            Ok(old)
+        }
+    }
+    fn write(&mut self, at: usize, bytes: &[u8]) -> Result<(), String> {
+        let address = self.address(at, bytes.len())?;
+        // SAFETY: transaction acquired this range's write permission first.
+        unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), address as *mut u8, bytes.len()) };
+        Ok(())
+    }
+    fn restore(&mut self, at: usize, len: usize, old: u32) -> Result<(), String> {
+        use windows_sys::Win32::System::Memory::VirtualProtect;
+        let address = self.address(at, len)?;
+        let mut ignored = 0;
+        // SAFETY: original token and range from a successful writable call.
+        if unsafe { VirtualProtect(address as *const _, len, old, &mut ignored) } == 0 {
+            Err(format!(
+                "VirtualProtect restore: {}",
+                std::io::Error::last_os_error()
+            ))
+        } else {
+            Ok(())
+        }
+    }
+    fn flush(&mut self, at: usize, len: usize) -> Result<(), String> {
+        use windows_sys::Win32::System::{
+            Diagnostics::Debug::FlushInstructionCache, Threading::GetCurrentProcess,
+        };
+        let address = self.address(at, len)?;
+        // SAFETY: live current-process mapping; no title code has run yet.
+        if unsafe { FlushInstructionCache(GetCurrentProcess(), address as *const _, len) } == 0 {
+            Err(format!(
+                "FlushInstructionCache: {}",
+                std::io::Error::last_os_error()
+            ))
+        } else {
+            Ok(())
+        }
+    }
+}
+
+/// Read the opt-in environment request; every error prevents title execution.
+///
+/// # Safety
+/// `base..base+size` is this original executable's live mapped image, whose
+/// original file hash is `original`. No title code runs or modifies it yet.
+#[cfg(windows)]
+pub unsafe fn apply_asked(
+    base: usize,
+    size: usize,
+    original: &blake3::Hash,
+) -> Result<ApplyOutcome, ResolutionError> {
+    let requested = match std::env::var("VICTORY_OUTPUT") {
+        Ok(spec) => Some(spec),
+        Err(std::env::VarError::NotPresent) => None,
+        Err(_) => return Err(error("VICTORY_OUTPUT is not Unicode")),
+    };
+    let Some(plan) = plan(requested.as_deref(), original.to_hex().as_str())? else {
+        return Ok(ApplyOutcome::Disabled);
+    };
+    // Validate all referenced globals/call targets in addition to code ranges.
+    for (at, len) in [
+        (SET_SCREEN_SIZE, 1),
+        (HEIGHT_CHANGED, 1),
+        (SCREEN_HEIGHT, 4),
+    ] {
+        range(at, len, size)?;
+        base.checked_add(at)
+            .and_then(|a| a.checked_add(len))
+            .ok_or_else(|| error("target address overflow"))?;
+    }
+    let mut image = MappedImage { base, size };
+    transaction(&mut image, size, &plan.patches)?;
+    tracing::info!(
+        width = plan.width,
+        height = plan.height,
+        "guest output: sites verified; output applied; native scale unchanged"
+    );
+    Ok(ApplyOutcome::Applied {
+        width: plan.width,
+        height: plan.height,
+    })
+}
+
