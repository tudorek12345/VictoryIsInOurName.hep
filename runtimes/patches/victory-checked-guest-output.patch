+#[test]
+fn reduced_output_keeps_the_unsigned_pool_bound_and_original_continuation() {
+    let code = pool_code();
+    assert_eq!(&code[..5], &[0x48, 0x3b, 0x44, 0x24, 0x78]);
+    assert_eq!(code[5], 0x76); // unsigned below-or-equal, not unconditional
+    assert_eq!(7 + code[6] as usize, code.len()); // exact original continuation
+    assert_eq!(&code[7..], &[0xcc, 0x90]); // failure still traps
+    let base = 0x0000_0002_0000_0000u64;
+    for capacity in [64u64 << 20, 82u64 << 20] {
+        for remaining in [0, capacity - 1, capacity] {
+            assert!(remaining <= capacity);
+        }
+        for remaining in [capacity + 1, u64::MAX] {
+            assert!(remaining > capacity);
+        }
+        for used in [0, 1, capacity - 1, capacity, capacity + 1] {
+            let cursor = base + used;
+            let remaining = capacity.wrapping_sub(cursor).wrapping_add(base);
+            assert_eq!(remaining <= capacity, used <= capacity);
+        }
+        let cursor_before_base = base - 1;
+        let remaining = capacity.wrapping_sub(cursor_before_base).wrapping_add(base);
+        assert!(remaining > capacity);
+    }
+}
