+use super::*;
+
+#[derive(Default)]
+struct Mock {
+    bytes: Vec<u8>,
+    writable: std::collections::BTreeMap<usize, bool>,
+    calls: Vec<&'static str>,
+    fail: Option<(&'static str, usize)>,
+    seen: usize,
+    persistent_restore_failure: bool,
+}
+
+impl Mock {
+    fn operation(&mut self, name: &'static str) -> Result<(), String> {
+        self.calls.push(name);
+        if self.fail.is_some_and(|(op, _)| op == name) {
+            self.seen += 1;
+            if self.fail.is_some_and(|(_, count)| self.seen == count) {
+                self.fail = None;
+                return Err(format!("injected {name}"));
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Memory for Mock {
+    type Protection = bool;
+    fn read(&mut self, at: usize, len: usize) -> Result<Vec<u8>, String> {
+        self.operation("read")?;
+        Ok(self.bytes[at..at + len].to_vec())
+    }
+    fn writable(&mut self, at: usize, _: usize) -> Result<bool, String> {
+        self.operation("writable")?;
+        Ok(self.writable.insert(at, true).unwrap_or(false))
+    }
+    fn write(&mut self, at: usize, bytes: &[u8]) -> Result<(), String> {
+        assert!(
+            self.writable
+                .range(..=at)
+                .next_back()
+                .is_some_and(|(_, &v)| v)
+        );
+        // Even a partial write must be rolled back.
+        self.bytes[at] = bytes[0];
+        self.operation("write")?;
+        self.bytes[at..at + bytes.len()].copy_from_slice(bytes);
+        Ok(())
+    }
+    fn restore(&mut self, at: usize, _: usize, old: bool) -> Result<(), String> {
+        if self.persistent_restore_failure {
+            return Err("persistent restore failure".into());
+        }
+        self.operation("restore")?;
+        self.writable.insert(at, old);
+        Ok(())
+    }
+    fn flush(&mut self, _: usize, _: usize) -> Result<(), String> {
+        self.operation("flush")
+    }
+}
+
+fn fixture() -> (Mock, Vec<Patch>) {
+    let bytes: Vec<u8> = (0..128).map(|i| (i * 7 + 13) as u8).collect();
+    let patches = [(16, 16, 0, vec![1, 2, 3]), (80, 8, 2, vec![4])]
+        .into_iter()
+        .map(|(at, len, write_offset, code)| Patch {
+            at,
+            len,
+            write_offset,
+            code,
+            expected: blake3::hash(&bytes[at..at + len]).to_hex().to_string(),
+        })
+        .collect();
+    (
+        Mock {
+            bytes,
+            ..Mock::default()
+        },
+        patches,
+    )
+}
+
+#[test]
+fn disabled_and_invalid_requests_do_not_create_a_patch_plan() {
+    assert!(plan(None, "unknown build").unwrap().is_none());
+    assert!(plan(Some("1920x1080"), "unknown build").is_err());
+    for spec in [
+        "",
+        "1080p",
+        "0x0",
+        "1600x900",
+        "1920x1080x1",
+        "4294967296x1080",
+    ] {
+        assert!(plan(Some(spec), ORIGINAL_BLAKE3).is_err(), "{spec}");
+    }
+    for (w, h) in MODES {
+        assert_eq!(parse_output(&format!(" {w} X {h} ")), Some((w, h)));
+    }
+}
+
+#[test]
+fn native_output_keeps_the_pool_assertion_but_still_verifies_its_digest() {
