+#[cfg(windows)]
+#[test]
+fn mapped_image_backend_restores_permissions_and_rejects_cross_region_reads() {
+    use windows_sys::Win32::System::Memory::{
+        MEM_COMMIT, MEM_RELEASE, MEM_RESERVE, MEMORY_BASIC_INFORMATION, PAGE_EXECUTE_READ,
+        PAGE_EXECUTE_READWRITE, PAGE_READONLY, VirtualAlloc, VirtualFree, VirtualProtect,
+        VirtualQuery,
+    };
+    struct Allocation(*mut std::ffi::c_void);
+    impl Drop for Allocation {
+        fn drop(&mut self) {
+            // SAFETY: this test exclusively owns the original reservation.
+            unsafe {
+                VirtualFree(self.0, 0, MEM_RELEASE);
+            }
+        }
+    }
+    // This is authored data, never executed and unrelated to title bytes.
+    unsafe {
+        let allocation = Allocation(VirtualAlloc(
+            std::ptr::null(),
+            0x3000,
+            MEM_RESERVE | MEM_COMMIT,
+            PAGE_EXECUTE_READWRITE,
+        ));
+        assert!(!allocation.0.is_null());
+        let base = allocation.0 as usize;
+        let mut expected: Vec<u8> = (0..0x3000).map(|i| (i * 11 + 17) as u8).collect();
+        std::ptr::copy_nonoverlapping(expected.as_ptr(), allocation.0.cast(), expected.len());
+        let patches: Vec<_> = [64, 0x2040]
+            .into_iter()
+            .map(|at| Patch {
+                at,
+                len: 16,
+                expected: blake3::hash(&expected[at..at + 16]).to_hex().to_string(),
+                write_offset: 2,
+                code: vec![91, 92, 93],
+            })
+            .collect();
+        let mut old = 0;
+        assert_ne!(
+            VirtualProtect(allocation.0, 0x3000, PAGE_EXECUTE_READ, &mut old),
+            0
+        );
+        assert_ne!(
+            VirtualProtect((base + 0x1000) as *const _, 0x1000, PAGE_READONLY, &mut old),
+            0
+        );
+        let mut memory = MappedImage { base, size: 0x3000 };
+        assert!(
+            memory.read(0xffc, 8).is_err(),
+            "cross-protection span must fail"
+        );
+        assert!(
+            memory.read(0x1000, 4).is_err(),
+            "non-executable data must fail"
+        );
+        transaction(&mut memory, 0x3000, &patches).unwrap();
+        for patch in &patches {
+            expected[patch.at + 2..patch.at + 5].copy_from_slice(&patch.code);
+            let mut info: MEMORY_BASIC_INFORMATION = std::mem::zeroed();
+            assert_ne!(
+                VirtualQuery(
+                    (base + patch.at) as *const _,
+                    &mut info,
+                    std::mem::size_of_val(&info)
+                ),
+                0
+            );
+            assert_eq!(info.Protect, PAGE_EXECUTE_READ);
+        }
+        assert_eq!(
+            std::slice::from_raw_parts(allocation.0.cast::<u8>(), expected.len()),
+            expected
+        );
+        assert!(
+            MappedImage {
+                base: usize::MAX - 3,
+                size: 128
+            }
+            .address(4, 4)
+            .is_err()
+        );
+    }
+}
