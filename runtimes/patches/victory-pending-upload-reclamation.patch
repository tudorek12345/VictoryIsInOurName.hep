@@ -90,7 +93,7 @@ pub(crate) fn reserve(len: usize) -> Option<usize> {
 impl Upload {
     pub(crate) fn new(len: usize) -> Option<Upload> {
         if !low() {
-            return Some(Upload(Kind::Heap(vec![0; len])));
+            return Some(Upload(Kind::Heap(vec![0; len]), #[cfg(test)] None));
