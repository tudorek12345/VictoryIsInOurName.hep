diff --git a/crates/victory-gpu/src/list/thin/pending_upload_tests.rs b/crates/victory-gpu/src/list/thin/pending_upload_tests.rs
new file mode 100644
index 0000000..951eec9
--- /dev/null
+++ b/crates/victory-gpu/src/list/thin/pending_upload_tests.rs
@@ -0,0 +1,145 @@
+//! Real upload ownership tests. Per-object drop observers are independent
+//! of global arena reuse and parallel test order. No GPU work is submitted.
+
+use super::*;
+
+fn recording_list() -> Box<List> {
+    let mut list = super::super::boxed(0, std::ptr::null(), true);
+    list.thin.begin(0, std::ptr::null());
+    list
+}
+
+fn this(list: &mut Box<List>) -> This {
+    std::ptr::from_mut(&mut **list).cast_const().cast()
+}
+
+fn pending_upload(list: &mut Box<List>) -> Arc<std::sync::atomic::AtomicUsize> {
+    let at = allocate_upload(this(list), 80, 16) as usize;
+    assert_ne!(at, 0);
+    assert_eq!(at % 16, 0);
+    let words = &list.thin.words;
+    assert_eq!(words[words.len() - 2], UPLOAD | (1 << 16));
+    // SAFETY: the real allocator just placed this Box in the unhanded
+    // Front tail. It is still exclusively owned here and has not been
+    // translated. Observe it before any ownership transfer or discard.
+    unsafe { (&mut *(words[words.len() - 1] as *mut Upload)).observe_drop() }
+}
+
+#[test]
+fn pending_upload_is_reclaimed_by_leave_exactly_once() {
+    let mut list = recording_list();
+    let dropped = pending_upload(&mut list);
+    list.thin.leave();
+    assert_eq!(dropped.load(SeqCst), 1);
+    // A second allocation may reuse the block, but its identity is its own
+    // observer, never inferred from a globally reusable address.
+    let mut next = Upload::new(96).unwrap();
+    let next_dropped = next.observe_drop();
+    list.thin.leave();
+    drop(list);
+    assert_eq!(dropped.load(SeqCst), 1);
+    assert_eq!(next_dropped.load(SeqCst), 0);
+    drop(next);
+    assert_eq!(next_dropped.load(SeqCst), 1);
+}
+
+#[test]
+fn pending_upload_is_reclaimed_by_actual_reset() {
+    let mut list = recording_list();
+    let dropped = pending_upload(&mut list);
+    let allocator = std::ptr::NonNull::<u64>::dangling()
+        .as_ptr()
+        .cast_const()
+        .cast();
+    assert_eq!(
+        list_reset(this(&mut list), allocator, std::ptr::null()),
+        S_OK
+    );
+    assert_eq!(dropped.load(SeqCst), 1);
+    assert_eq!(list.thin.words, [RESET | (1 << 16), 0]);
+    drop(list);
+    assert_eq!(dropped.load(SeqCst), 1);
+}
+
+#[test]
+fn pending_upload_is_reclaimed_by_actual_list_drop() {
+    let mut list = recording_list();
+    let dropped = pending_upload(&mut list);
+    drop(list);
+    assert_eq!(dropped.load(SeqCst), 1);
+}
+
+#[test]
+fn pending_upload_handed_to_worker_stays_owned_until_translated_list_drops() {
+    let mut list = recording_list();
+    let dropped = pending_upload(&mut list);
+    let recording = list.thin.recording.as_ref().unwrap().clone();
+    // Simulate a worker already owning this Recording. The real hand_over
+    // transfers the chunk but does not enqueue an additional global worker.
+    held(&recording.inner).scheduled = true;
+    list.thin.hand_over();
+    assert!(list.thin.words.is_empty());
+    list.thin.leave();
+    assert_eq!(dropped.load(SeqCst), 0);
+
+    let chunk = held(&recording.inner).chunks.pop_front().unwrap();
+    let mut back = super::super::boxed(0, std::ptr::null(), false);
+    assert_eq!(super::super::close(this(&mut back)), S_OK);
+    // The production translator must keep owning UPLOAD even after the
+    // title abandoned its Front; it can still be finishing earlier work.
+    let _ = translate(this(&mut back), &chunk, || true);
+    assert_eq!(held(&back.uploads).len(), 1);
+    assert_eq!(dropped.load(SeqCst), 0);
+    drop(chunk); // Translated words no longer own their raw UPLOAD pointer.
+    drop(list);
+    drop(recording);
+    assert_eq!(dropped.load(SeqCst), 0);
+    drop(back);
+    assert_eq!(dropped.load(SeqCst), 1);
+}
+
+#[test]
+fn pending_upload_parser_skips_payload_headers_and_is_idempotent() {
+    let mut words = vec![
+        RESET | (1 << 16),
+        0,
+        // A variable-sized packet contains a fake UPLOAD header/pointer.
+        TARGETS | (4 << 16),
+        9,
+        UPLOAD | (1 << 16),
+        0xaaaa,
+        7,
+        UPLOAD | (1 << 16),
+        0xbbbb,
+        GRAPHICS_CONSTANTS | (3 << 16),
+        UPLOAD | (1 << 16),
+        0xcccc,
+        0,
+        UPLOAD | (1 << 16),
+        0xdddd,
+    ];
+    let mut released = Vec::new();
+    assert_eq!(drain_pending_uploads(&mut words, |p| released.push(p)), 2);
+    assert_eq!(released, [0xbbbb, 0xdddd]);
+    assert!(words.is_empty());
+    assert_eq!(
+        drain_pending_uploads(&mut words, |_| panic!("double release")),
+        0
+    );
+}
+
+#[test]
+fn pending_upload_parser_rejects_truncated_or_wrong_arity_packets() {
+    for mut words in [
+        vec![UPLOAD],
+        vec![UPLOAD | (2 << 16), 0xaaaa, 0xbbbb],
+        vec![TARGETS | (8 << 16), UPLOAD | (1 << 16), 0xaaaa],
+        vec![u64::MAX, UPLOAD | (1 << 16), 0xaaaa],
+    ] {
+        assert_eq!(
+            drain_pending_uploads(&mut words, |_| panic!("invalid ownership")),
+            0
+        );
+        assert!(words.is_empty());
+    }
+}
