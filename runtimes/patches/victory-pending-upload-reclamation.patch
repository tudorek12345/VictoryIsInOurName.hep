--- a/crates/victory-gpu/src/list/thin.rs
+++ b/crates/victory-gpu/src/list/thin.rs
@@ -83,7 +83,7 @@ impl Front {
         {
             recording.abandoned.store(true, Release);
         }
-        self.words.clear();
+        discard_pending_uploads(&mut self.words);
     }
 
     /// Begins a recording, with `pipeline` bound.
@@ -168,9 +168,48 @@ static WORK: Condvar = Condvar::new();
 static BACKS: Mutex<Vec<usize>> = Mutex::new(Vec::new());
 /// Since the last line of the log: streams handed over; calls translated and
 /// the microseconds that took (all threads), recordings translated, and
-/// recordings let go of in the middle.
+/// recordings let go of in the middle, and pending uploads reclaimed.
 static CHUNKS: AtomicU64 = AtomicU64::new(0);
-static STATS: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+static STATS: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+
+/// Discards only words still owned by a Front, never handed to a worker.
+/// UPLOAD transfers a boxed allocation through the stream; simply clearing
+/// these words loses its owner and leaves its arena blocks permanently taken.
+fn discard_pending_uploads(words: &mut Vec<u64>) {
+    let reclaimed = drain_pending_uploads(words, |raw| {
+        // SAFETY: allocate_upload made this box, and these pending words
+        // were never handed over or translated. Each UPLOAD owns one box.
+        drop(unsafe { Box::from_raw(raw as *mut Upload) });
+    });
+    if reclaimed != 0 {
+        STATS[4].fetch_add(reclaimed, Relaxed);
+    }
+}
+
+/// Walk packet boundaries, not payload words: variable-sized blobs may
+/// contain anything, including the numeric value of an UPLOAD header.
+/// Stop at malformed bounds/UPLOAD arity rather than interpreting payload
+/// as ownership. The stream is internal; malformed tails have no trusted
+/// ownership information. Clearing also makes a repeated discard a no-op.
+fn drain_pending_uploads(words: &mut Vec<u64>, mut release: impl FnMut(u64)) -> u64 {
+    let (mut at, mut reclaimed) = (0usize, 0u64);
+    while let Some(&header) = words.get(at) {
+        let Ok(len) = usize::try_from(header >> 16) else { break };
+        let Some(end) = at.checked_add(1).and_then(|start| start.checked_add(len))
+            .filter(|&end| end <= words.len()) else { break };
+        if header & 0xffff == UPLOAD {
+            if len != 1 { break; }
+            let raw = std::mem::take(&mut words[at + 1]);
+            if raw != 0 {
+                release(raw);
+                reclaimed += 1;
+            }
+        }
+        at = end;
+    }
+    words.clear();
+    reclaimed
+}
 
 fn held<T>(m: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
     m.lock().unwrap_or_else(|e| e.into_inner())
@@ -350,12 +389,13 @@ pub(crate) fn line(frames: f64) {
     }
     let s: Vec<f64> = STATS.iter().map(|s| s.swap(0, Relaxed) as f64 / frames).collect();
     tracing::info!(
-        "list calls translated by threads of ours per frame (VICTORY_THIN): {:.0} in {:.1} ms (all threads), {:.1} lists, {:.1} pieces; left in the middle {:.2}",
+        "list calls translated by threads of ours per frame (VICTORY_THIN): {:.0} in {:.1} ms (all threads), {:.1} lists, {:.1} pieces; left in the middle {:.2}; pending uploads reclaimed {:.2}",
         s[0],
         s[1] / 1000.0,
         s[2],
         CHUNKS.swap(0, Relaxed) as f64 / frames,
-        s[3]
+        s[3],
+        s[4]
     );
 }
 
