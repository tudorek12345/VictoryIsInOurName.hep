+impl Line {
+    /// A synchronous completion can age the remaining landed flights even
+    /// if no new flight arrives. Recycling belongs to the helper, outside
+    /// the submission lock and any locks held by its caller.
+    fn poke_completed_lists(&mut self, finished: u64, lag: u64) -> bool {
+        let ready = self.landed.first().is_some_and(|flight| completed_list_ready(flight.number, finished, lag));
+        if ready {
+            self.poke = true;
+        }
+        ready
+    }
+}
