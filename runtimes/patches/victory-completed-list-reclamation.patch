+    /// Only detached lists past their final submission's quarantine use
+    /// this path. Reset, Drop and ordinary tables_done retain their delay.
+    pub(crate) fn tables_completed(&mut self, completed: &crate::host::CompletedListRetirement) {
+        for slots in self.dynamic.drain(..) {
+            slots.release_completed(completed);
+        }
+        self.clear_table_cache();
+    }
