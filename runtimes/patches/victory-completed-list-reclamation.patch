+
+/// Only land() creates this in production, after a detached flight's fence,
+/// copyback, readbacks and submission quarantine. Its descriptor references
+/// must not enter a second quarantine dated from the current queue tail.
+pub(crate) struct CompletedListRetirement {
+    _private: (),
+}
+
+fn completed_list_retirement(number: u64, finished: u64, lag: u64) -> Option<CompletedListRetirement> {
+    completed_list_ready(number, finished, lag).then_some(CompletedListRetirement { _private: () })
+}
+
+#[cfg(test)]
+pub(crate) fn test_completed_list_retirement(number: u64, finished: u64, lag: u64) -> Option<CompletedListRetirement> {
+    completed_list_retirement(number, finished, lag)
+}
+
+/// Keep the existing submission quarantine, not a count of newer flight
+/// containers. Checked addition prevents early release near zero/overflow.
+fn completed_list_ready(number: u64, finished: u64, lag: u64) -> bool {
+    number.checked_add(lag).is_some_and(|after| after <= finished)
+}
+
+fn completed_list_prefix(numbers: impl IntoIterator<Item = u64>, finished: u64, lag: u64) -> usize {
+    // Preserve order conservatively if a newer flight was published first.
+    numbers.into_iter().take_while(|&number| completed_list_ready(number, finished, lag)).count()
+}
+
+fn wake_completed_lists(finished: u64) {
+    let wake = line().poke_completed_lists(finished, bury_lag());
+    if wake {
+        LINE_MOVED.notify_one();
+    }
+}
+
