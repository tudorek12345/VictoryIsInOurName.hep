+/// The stronger land-only contract: the final part owning State has also
+/// passed its submission quarantine. Clear leases even when pooling is off.
+#[cfg(windows)]
+pub(crate) fn recycle_completed(mut lists: Vec<Detached>, ran: &[usize], completed: &crate::host::CompletedListRetirement) {
+    for list in &mut lists {
+        list._state.tables_completed(completed);
+    }
+    recycle(lists, ran);
+}
