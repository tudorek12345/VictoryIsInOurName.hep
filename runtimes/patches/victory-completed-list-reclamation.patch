+    /// Consumes this recording's lease after its final submitted part has
+    /// completed the host's quarantine. Other slots keep their own references.
+    pub(crate) fn release_completed(mut self, _completed: &crate::host::CompletedListRetirement) {
+        // Disarm Drop before returning slots: a newly allocated lease must
+        // never be returned again by this one, even during unwinding.
+        let count = std::mem::take(&mut self.count);
+        drop(self.heap.take_released_resources(self.first, count));
+    }
 }
 
