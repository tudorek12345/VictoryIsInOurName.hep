+        assert_eq!(completed_list_prefix([10, 20], 73, 64), 0);
+        assert_eq!(completed_list_prefix([10, 20], 74, 64), 1);
+        assert_eq!(completed_list_prefix([10, 20], 84, 64), 2);
+    }
+
+    #[test]
