+        assert!(!completed_list_ready(1, 0, 64));
+        assert!(!completed_list_ready(65, 64, 0));
+        assert!(!completed_list_ready(u64::MAX - 31, u64::MAX, 64));
+        assert!(completed_list_ready(u64::MAX - 64, u64::MAX, 64));
+        assert!(completed_list_retirement(10, 73, 64).is_none());
+        assert!(completed_list_retirement(10, 74, 64).is_some());
+        assert!(completed_list_retirement(u64::MAX, u64::MAX, 64).is_none());
+    }
