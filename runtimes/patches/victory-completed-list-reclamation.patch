+    #[test]
+    fn completed_dynamic_lease_drops_only_its_pin_without_a_second_quarantine() {
+        use std::sync::Arc;
+        use std::sync::atomic::Ordering::Relaxed;
+
+        let heap = Arc::new(HostHeap::new(false, 4).expect("host descriptor heap required"));
+        let resource = crate::host::host().unwrap().read_back_buffer(256).expect("small ownership test buffer");
+        let refs = || crate::host::references(&resource);
+        let base = refs();
+        let free = heap.free.load(Relaxed);
+        let completed_slots = heap.dynamic_slots(1).unwrap();
+        let other_slots = heap.dynamic_slots(1).unwrap();
+        heap.keep(completed_slots.first(), Some(resource.clone()));
+        heap.keep(other_slots.first(), Some(resource.clone()));
+        assert_eq!(refs(), base + 2);
+
+        // No capability exists before the full last-use quarantine.
+        assert!(crate::host::test_completed_list_retirement(10, 73, 64).is_none());
+        assert_eq!(refs(), base + 2);
+        let completed = crate::host::test_completed_list_retirement(10, 74, 64).unwrap();
+        completed_slots.release_completed(&completed);
+        assert_eq!(refs(), base + 1, "the completed pin is dropped, not queued again");
+        assert_eq!(heap.free.load(Relaxed), free - 1);
+        assert!(heap.kept[other_slots.first() as usize].lock().unwrap().is_some());
+
+        let replacement = heap.dynamic_slots(1).unwrap();
+        heap.keep(replacement.first(), Some(resource.clone()));
+        assert_eq!(refs(), base + 2);
+        // Ordinary Drop still transfers its pin into retirement. It must
+        // not acquire the land-only immediate-release behavior.
+        drop(other_slots);
+        assert_eq!(refs(), base + 2);
+        assert_eq!(heap.free.load(Relaxed), free - 1);
+        replacement.release_completed(&completed);
+        assert_eq!(refs(), base + 1, "only the ordinary Drop's retired reference remains");
+        assert_eq!(heap.free.load(Relaxed), free);
+    }
