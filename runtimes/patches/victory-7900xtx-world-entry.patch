--- /dev/null
+++ b/crates/victory-shader/src/emit/pops_tests.rs
@@ -0,0 +1,132 @@
+//! Regression for inactive pixel lanes entering the console's ordered-wave wait.
+//!
+//! Adapted from Marvisak/VIctory 7ac1f54d to the instruction-use detector in this
+//! branch: the collision SGPR must feed a packer extract and an ordered section.
+//! Only a four-pixel WARP target is used; no title or hardware-GPU run is needed.
+
+use super::container::SigElement;
+use super::host::{Draw, Host};
+use super::{Container, FourCC, HostShader, container, emit, validator};
+use crate::native::{HwStage, NativeProgram, StageIo, Usage, VsInput};
+use crate::{io, ir, resource, structure};
+
+fn signature(name: &str, kind: u8, interp: u8) -> SigElement {
+    SigElement {
+        name: name.into(),
+        index: 0,
+        kind,
+        comp: 9,
+        interp,
+        row: Some(0),
+        col: 0,
+        cols: 4,
+        usage: 15,
+        half: false,
+    }
+}
+
+fn translated(native: &NativeProgram, inputs: Vec<SigElement>, outputs: Vec<SigElement>) -> HostShader {
+    let isg1 = container::signature(&inputs, true);
+    let osg1 = container::signature(&outputs, false);
+    let bytes = crate::dxbc::build(&[(FourCC::ISG1, &isg1), (FourCC::OSG1, &osg1)]);
+    let c = Container::parse(&bytes).expect("container");
+    let p = ir::build(&native.patched_code(), native.wave64, native.vgprs).expect("ir");
+    let st = structure::structure(&p).expect("structure");
+    let res = resource::track(&p, &native.layout, native.stage, Some(&st)).expect("resources");
+    let io = io::raise(&p, native).expect("inputs");
+    let shader = emit(&c, native, &p, &st, &io, &res).expect("emit");
+    if let Ok(mut v) = validator::Validator::load(validator::Validator::default_path().as_deref()) {
+        v.validate(&mut shader.dxil.clone()).expect("DXIL validation");
+    }
+    shader
+}
+
+#[test]
+fn pops_wait_exits_for_inactive_pixel_lanes() {
+    let _one = super::valu_tests::ONE_AT_A_TIME.lock().unwrap_or_else(|e| e.into_inner());
+    let host = Host::new(true).expect("WARP host");
+    for wave64 in [false, true] {
+        let vs_code: [u32; 3] = [0xF800_08CF, 0x0706_0504, 0xBF81_0000];
+        let vs_native = NativeProgram {
+            stage: HwStage::Vs,
+            wave64,
+            vgprs: 8,
+            layout: Vec::new(),
+            used: Vec::new(),
+            io: StageIo::Vs {
+                inputs: vec![VsInput { usage: Usage::Generic, row: 0, mask: 15, vgpr: 4 }],
+                outputs: Vec::new(),
+            },
+            code: vs_code.iter().flat_map(|w| w.to_le_bytes()).collect(),
+        };
+        let vs = translated(&vs_native,
+            vec![signature("POSITION", 0, 0)],
+            vec![signature("SV_Position", 3, 4)]);
+
+        // Keep s9 as a real hardware input (no root-constant stand-in). The
+        // packer extract and setreg make this exercise pops_collision(), which
+        // differs from upstream's initialized-SGPR/db_shader_control detector.
+        let ps_code: [u32; 34] = [
+            0xBE8C_0380, // s_mov_b32 s12, 0 (iteration count)
+            if wave64 { 0xBE94_047E } else { 0xBE94_037E }, // save exec in s[20:21] / s20
+            0x7C28_00F4, // v_cmpx_gt_f32 exec, 2.0, v0: x < 2 is active
+            0x9390_FF09, 0x0002_001C, // s_bfe_u32 s16, s9, packer bits 28..29
+            0x8F10_8110, // s_lshl_b32 s16, s16, 1
+            0x8810_8110, // s_or_b32 s16, s16, 1
+            0xB990_1019, // s_setreg_b32 hwreg(POPS_PACKER, 0, 3), s16
+            0x9382_FF09, 0x000A_0000, // s_bfe_u32 s2, s9, collision id
+            0x9385_FF09, 0x000A_0010, // s_bfe_u32 s5, s9, wave id
+            0xBE84_0702, // s_not_b32 s4, s2
+            0x9000_9F09, // s_lshr_b32 s0, s9, 31: overlap bit
+            0x8105_0405, // s_add_i32 s5, s5, s4
+            0xBF06_8000, // s_cmp_eq_u32 s0, 0
+            if wave64 { 0x8580_807E } else { 0x8500_807E }, // s_cselect s[0:1] / s0, exec, 0
+            0x8102_04EF, // s_add_i32 s2, src_pops_exiting_wave_id, s4
+            0xBF08_0502, // s_cmp_gt_u32 s2, s5
+            if wave64 { 0x8582_807E } else { 0x8502_807E }, // s_cselect s[2:3] / s2, exec, 0
+            if wave64 { 0x8880_0200 } else { 0x8800_0200 }, // s_or s[0:1] / s0, s0, s2
+            if wave64 { 0x87EA_007E } else { 0x876A_007E }, // s_and vcc, exec, s0
+            0xBF87_0005, // s_cbranch_vccnz +5 (past wait)
+            0xBF8E_FFFF, // s_sleep 0xffff
+            0x810C_810C, // s_add_i32 s12, s12, 1
+            0x8100_04EF, // s_add_i32 s0, src_pops_exiting_wave_id, s4
+            0xBF0A_0005, // s_cmp_lt_u32 s5, s0
+            0xBF84_FFFB, // s_cbranch_scc0 -5 (back to sleep)
+            0xBF90_0007, // s_sendmsg MSG_ORDERED_PS_DONE
+            if wave64 { 0xBEFE_0414 } else { 0xBEFE_0314 }, // restore exec
+            0x7E08_0C0C, // v_cvt_f32_u32 v4, s12
+            0xF800_180F, 0x0404_0404, // exp mrt0, v4, v4, v4, v4 done vm
+            0xBF81_0000, // s_endpgm
+        ];
+        let ps_native = NativeProgram {
+            stage: HwStage::Ps,
+            wave64,
+            vgprs: 8,
+            layout: Vec::new(),
+            used: Vec::new(),
+            io: StageIo::Ps {
+                inputs: Vec::new(),
+                input_addr: 1 << 8, // SV_Position.x in v0
+                db_shader_control: 0, // instruction detector, not upstream's bit 16
+                patches: Vec::new(),
+            },
+            code: ps_code.iter().flat_map(|w| w.to_le_bytes()).collect(),
+        };
+        let ps = translated(&ps_native,
+            vec![signature("SV_Position", 3, 4)],
+            vec![signature("SV_Target", 16, 0)]);
+        let (root, pso) = host.pipeline(&vs, &ps).expect("pipeline");
+        let pixels = host.draw(&root, &pso, &Draw {
+            roots: Vec::new(),
+            textures: &[],
+            samplers: &[],
+            vertices: &[-1.0, -1.0, 0.0, 1.0, -1.0, 3.0, 0.0, 1.0, 3.0, -1.0, 0.0, 1.0],
+            stride: 16,
+            size: (4, 1),
+            mesh_groups: 0,
+        }).expect("draw");
+        // With wave id == collision id == 0 the latter pixels spin until
+        // LOOP_LIMIT. Wave id 1 makes the unsigned wrap-around compare pass.
+        assert_eq!(pixels, vec![[0.0; 4], [0.0; 4], [1.0; 4], [1.0; 4]], "wave64={wave64}");
+    }
+}
