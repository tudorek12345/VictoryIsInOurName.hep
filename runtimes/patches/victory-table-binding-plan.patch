+#[cfg(test)]
+mod table_plan_tests {
+    use super::{ResourceType, RootIndexedView, RootType, TablePlan, UsedResource};
+
+    fn resource(slot: u8, dword: u32, kind: ResourceType) -> UsedResource {
+        UsedResource {
+            kind, root: RootType::Table, table_offset_dwords: dword,
+            lower_bound: 0, stride: 1, dwords: 8, user_data: 0, slot,
+        }
+    }
+
+    // The old bind path scans every declaration independently. This oracle
+    // intentionally does not use TableGroup's maximum or descriptor lookup.
+    fn old_snapshot(entries: &[UsedResource], host_count: u32, index_at: impl Fn(u32) -> Option<u32>) -> bool {
+        entries.iter().any(|u| index_at(u.table_offset_dwords).is_some_and(|i| i >= host_count))
+    }
+
+    fn heap_index(start: u64, count: u32, step: u64, table: u64, dword: u32) -> Option<u32> {
+        let address = table.checked_add(u64::from(dword) * 4)?;
+        let index = address.checked_sub(start)? / step;
+        (index < u64::from(count)).then_some(index as u32)
+    }
+
+    #[test]
+    fn table_plan_preserves_interleaved_order_holes_and_first_duplicate() {
+        let mut root_view = resource(1, 0, ResourceType::Srv);
+        root_view.root = RootType::Descriptor;
+        let used = [
+            resource(9, 24, ResourceType::Srv), root_view,
+            resource(2, 0, ResourceType::Cbv),
+            resource(9, 24, ResourceType::Uav),
+            resource(2, 40, ResourceType::Srv),
+            resource(255, 16, ResourceType::Srv),
+        ];
+        let indexed = [
+            RootIndexedView { table_slot: 9, constant_slot: 2, constant_dword: 3, byte_offset: 96, shift: 5 },
+            RootIndexedView { table_slot: 2, constant_slot: 4, constant_dword: 0, byte_offset: 0, shift: 2 },
+            RootIndexedView { table_slot: 9, constant_slot: 1, constant_dword: 1, byte_offset: 32, shift: 3 },
+        ];
+        let plan = TablePlan::new(&used, &indexed);
+        let direct: Vec<_> = plan.direct.iter().map(|&(g, e)| plan.groups[g].entries[e]).collect();
+        assert_eq!(direct, used.iter().copied().filter(|u| u.root == RootType::Table).collect::<Vec<_>>());
+        assert_eq!(plan.groups.iter().map(|g| g.slot).collect::<Vec<_>>(), [2, 9, 255]);
+        for group in &plan.groups {
+            let old: Vec<_> = used.iter().copied().filter(|u| u.root == RootType::Table && u.slot == group.slot).collect();
+            assert_eq!(group.entries, old);
+            assert_eq!(group.indexed, indexed.iter().copied().filter(|v| v.table_slot == group.slot).collect::<Vec<_>>());
+            assert_eq!(group.has_cbv, old.iter().any(|u| u.kind == ResourceType::Cbv));
+            assert_eq!(group.has_uav, old.iter().any(|u| u.kind == ResourceType::Uav));
+            for descriptor in 0..10 {
+                assert_eq!(group.entry(descriptor), old.iter().find(|u| u.table_offset_dwords / 8 == descriptor));
+            }
+        }
+        assert_eq!(plan.groups[1].entry(3).unwrap().kind, ResourceType::Srv);
+        assert!(plan.groups[1].entry(2).is_none());
+        assert!(TablePlan::new(&[], &indexed).groups.is_empty());
+    }
+
+    #[test]
+    fn table_plan_matches_old_selection_across_changed_bindings() {
+        let used = [
+            resource(7, 0, ResourceType::Srv), resource(2, 8, ResourceType::Cbv),
+            resource(7, 80, ResourceType::Srv), resource(255, 16, ResourceType::Uav),
+        ];
+        let plan = TablePlan::new(&used, &[]);
+        // Reuse one immutable plan across distinct table bases and host caps;
+        // a previous draw's snapshot selection must not leak into the next.
+        for roots in [[Some(0x1000), Some(0x1000), None], [None, Some(0x1020), Some(0x1000)], [Some(0x1100), None, Some(0x1040)]] {
+            for host_count in [1, 8, 32] {
+                let mut old_fresh = Vec::new();
+                let mut planned_fresh = Vec::new();
+                for (group, table) in plan.groups.iter().zip(roots) {
+                    let old_entries: Vec<_> = used.iter().copied().filter(|u| u.slot == group.slot).collect();
+                    let old = old_entries.iter().any(|u| u.kind == ResourceType::Cbv)
+                        || table.is_some_and(|table| old_snapshot(&old_entries, host_count, |d| heap_index(0x1000, 32, 32, table, d)));
+                    let planned = group.has_cbv
+                        || table.is_some_and(|table| group.needs_snapshot_at(host_count, |d| heap_index(0x1000, 32, 32, table, d)));
+                    if old { old_fresh.push(group.slot); }
+                    if planned { planned_fresh.push(group.slot); }
+                    for selected in [vec![], vec![0, 4, 4], vec![17]] {
+                        let old_span = old_entries.iter().map(|u| u.table_offset_dwords / 8).chain(selected.iter().copied()).max().unwrap_or(0) + 1;
+                        let new_span = (group.max_dword / 8).max(selected.last().copied().unwrap_or(0)) + 1;
+                        assert_eq!(new_span, old_span);
+                    }
+                }
+                assert_eq!(planned_fresh, old_fresh);
+                let old_direct: Vec<_> = used.iter().copied().filter(|u| !old_fresh.contains(&u.slot)).collect();
+                let new_direct: Vec<_> = plan.direct.iter().map(|&(g, e)| plan.groups[g].entries[e]).filter(|u| !planned_fresh.contains(&u.slot)).collect();
+                assert_eq!(new_direct, old_direct);
+            }
+        }
+    }
+
+    #[test]
+    fn table_plan_invalid_maximum_still_checks_earlier_valid_entries() {
+        let plan = TablePlan::new(&[resource(0, 8, ResourceType::Srv), resource(0, 80, ResourceType::Srv)], &[]);
+        let group = &plan.groups[0];
+        // Maximum is outside the title heap, but descriptor 1 exists and is
+        // past a host heap capped at one descriptor.
+        assert!(group.needs_snapshot_at(1, |d| heap_index(0x1000, 10, 32, 0x1000, d)));
+        assert!(!group.needs_snapshot_at(2, |d| heap_index(0x1000, 10, 32, 0x1000, d)));
+        let overflow = TablePlan::new(&[resource(0, 0, ResourceType::Srv), resource(0, 16, ResourceType::Srv)], &[]);
+        assert!(overflow.groups[0].needs_snapshot_at(0, |d| heap_index(u64::MAX - 31, 1, 32, u64::MAX - 31, d)));
+        assert!(!overflow.groups[0].needs_snapshot_at(1, |d| heap_index(u64::MAX - 31, 1, 32, u64::MAX - 31, d)));
+    }
+
+    #[test]
+    fn table_plan_snapshot_matches_old_scan_at_heap_boundaries() {
+        for a in [0, 1, 7, 8, 15, 16, 63, 64, 255, u32::MAX] {
+            for b in [0, 8, 32, u32::MAX] {
+                let used = [resource(0, a, ResourceType::Srv), resource(0, b, ResourceType::Uav)];
+                let plan = TablePlan::new(&used, &[]);
+                for (start, table) in [(0x1000, 0x1000), (0x1000, 0x101f), (0x1000, 0x1040), (u64::MAX - 127, u64::MAX - 63)] {
+                    for step in [16, 32] {
+                        for count in [1, 4, 16] {
+                            for host_count in [0, 1, 8, 64] {
+                                let at = |d| heap_index(start, count, step, table, d);
+                                assert_eq!(plan.groups[0].needs_snapshot_at(host_count, at), old_snapshot(&used, host_count, at), "offsets {a}/{b}, table {table}, count {count}, cap {host_count}");
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
