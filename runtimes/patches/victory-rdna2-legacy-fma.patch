+    /// Quad reads must include rasterizer helper lanes even when the other
+    /// half of a quad is covered by a different triangle (DexNom 921d8d3).
+    #[cfg(windows)]
+    #[test]
+    fn pixel_quad_reads_include_helper_lanes_at_triangle_edges() {
+        use super::bitcode::{Attr, Term};
+        use super::host::{Draw, Host};
+        use super::shader::Shader;
+        use windows::Win32::Graphics::Direct3D12::D3D12_SHADER_VISIBILITY_PIXEL;
+
+        let _one = super::valu_tests::ONE_AT_A_TIME.lock().unwrap_or_else(|e| e.into_inner());
+
+        let mut vs = Shader::new(false);
+        let mut input = element("POSITION", 0, 0);
+        input.usage = 15;
+        vs.inputs.push(input);
+        let mut output = element("SV_Position", 3, 0);
+        output.usage = 15;
+        output.interp = 4;
+        vs.outputs.push(output);
+        let zero = vs.m.i32(0);
+        let undef = vs.m.undef(vs.t.i32);
+        for col in 0..4 {
+            let col = vs.m.i8(col);
+            let value = vs.op(vs.entry, "loadInput.f32", Attr::ReadNone, vs.t.f32, 4,
+                &[zero, zero, col, undef]);
+            vs.op(vs.entry, "storeOutput.f32", Attr::NoUnwind, vs.t.void, 5,
+                &[zero, zero, col, value]);
+        }
+        vs.m.terminate(vs.entry, Term::Ret);
+        let vs = vs.finish();
+
+        const SIZE: usize = 16;
+        let a = [-1.0, -1.0, 0.5, 1.0];
+        let b = [-1.0, 1.0, 0.5, 1.0];
+        let c = [1.0, -1.0, 0.5, 1.0];
+        let d = [1.0, 1.0, 0.5, 1.0];
+        // Broadcasts, all native exchanges, identity, and a mixed permutation.
+        let patterns = [0x00, 0x55, 0xaa, 0xff, 0xb1, 0x4e, 0x1b, 0xe4, 0x27];
+        let mut devices_checked = 0;
+        for (name, warp) in [("hardware", false), ("WARP", true)] {
+            if !warp && std::env::var_os("VICTORY_WARP").is_some() {
+                eprintln!("hardware quad edge probe skipped under VICTORY_WARP");
+                continue;
+            }
+            let Ok(host) = Host::new(warp) else {
+                eprintln!("no SM 6.6 {name} device; skipped quad edge probe");
+                continue;
+            };
+            let mut checked = 0;
+            for dpp in [false, true] {
+                for pattern in patterns {
+                    let mut words = vec![0xBEFE_097E]; // whole-quad mode
+                    for dst in 2..6u32 {
+                        let src = dst & 1; // SV_Position.x / y
+                        words.extend(if dpp {
+                            [0x7E00_02FA | dst << 17, 0xFF00_0000 | pattern << 8 | src]
+                        } else {
+                            [0xD8D4_8000 | pattern, dst << 24 | src]
+                        });
+                    }
+                    words.extend([0xF800_180F, 0x0504_0302, 0xBF81_0000]);
+                    let ps = pixel_with_inputs(&words, (1 << 8) | (1 << 9),
+                        &[element("SV_Position", 3, 0)]).unwrap();
+                    validate(&ps);
+                    let root = host.root_signature_for(&[(&ps, D3D12_SHADER_VISIBILITY_PIXEL)]).unwrap();
+                    let pso = host.pipeline_with(&root, &vs, &ps.dxil).unwrap();
+                    // Each draw starts cleared. Summing the complementary halves
+                    // checks coverage as well as the partner coordinates.
+                    let halves = [[a, b, c], [b, c, d]].map(|triangle| {
+                        host.draw(&root, &pso, &Draw {
+                            roots: Vec::new(), textures: &[], samplers: &[],
+                            vertices: triangle.as_flattened(), stride: 16,
+                            size: (SIZE as u32, SIZE as u32), mesh_groups: 0,
+                        }).unwrap()
+                    });
+                    for y in 0..SIZE {
+                        for x in 0..SIZE {
+                            let lane = (x & 1) | ((y & 1) << 1);
+                            let partner = (pattern >> (lane * 2)) & 3;
+                            let px = (x & !1) as f32 + (partner & 1) as f32 + 0.5;
+                            let py = (y & !1) as f32 + (partner >> 1) as f32 + 0.5;
+                            let actual: [f32; 4] = std::array::from_fn(|channel|
+                                halves[0][y * SIZE + x][channel] + halves[1][y * SIZE + x][channel]);
+                            assert_eq!(actual, [px, py, px, py],
+                                "{name} dpp={dpp} permutation={pattern:#x} pixel=({x},{y})");
+                        }
+                    }
+                    checked += 1;
+                }
+            }
+            assert_eq!(checked, 18);
+            devices_checked += 1;
+            eprintln!("{name}: executed {checked} quad edge cases (256 pixels each)");
+        }
+        if devices_checked == 0 {
+            eprintln!("quad edge probe skipped: no hardware or WARP draw executed");
+        }
+    }
