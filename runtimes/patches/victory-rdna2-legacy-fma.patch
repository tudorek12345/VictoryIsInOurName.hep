+    /// RDNA2 reuses the legacy MAD/MAC encodings for fused FMA/FMAC.
+    /// A zero factor gives a +0 product even if the other factor is NaN or
+    /// infinite. Keep the existing denormal policy: input flushing is MODE
+    /// dependent, not an unconditional property of these opcodes.
+    fn legacy_fmad(&mut self, a: V, b: V, addend: V) -> V {
+        let c = self.cur;
+        let fused = self.fmad(a, b, addend);
+        let zero = self.s.m.f32(0);
+        let az = self.s.m.cmp(c, pred::OEQ, a, zero);
+        let bz = self.s.m.cmp(c, pred::OEQ, b, zero);
+        let zero_factor = self.s.m.bin(c, Bin::Or, az, bz);
+        let without_product = self.s.m.bin(c, Bin::Add, zero, addend);
+        // The host can fold +0 + x to x, losing +0 + -0 == +0. Preserve
+        // that case through integer bits; other inputs keep the add's policy.
+        let addend_bits = self.as_int(addend);
+        let magnitude = self.s.m.i32(0x7FFF_FFFF);
+        let magnitude = self.s.m.bin(c, Bin::And, addend_bits, magnitude);
+        let zero_bits = self.s.m.i32(0);
+        let addend_zero = self.s.m.cmp(c, pred::EQ, magnitude, zero_bits);
+        let sum_bits = self.as_int(without_product);
+        let sum_bits = self.s.m.select(c, addend_zero, zero_bits, sum_bits);
+        let without_product = self.as_float(sum_bits);
+        self.s.m.select(c, zero_factor, without_product, fused)
+    }
