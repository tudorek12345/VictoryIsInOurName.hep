+/// The decoder retains the pre-RDNA2 names, but 0x140 and VOP2 0x06 are
+/// FMA_LEGACY/FMAC_LEGACY on RDNA2 (AMD ISA, instruction changes p3).
+fn legacy_fma_programs() -> [(&'static str, HostShader); 2] {
+    let mad = build_valu_cs(&vop3(0x140, 0, vgpr(1), vgpr(2), vgpr(3)));
+    let mac = build_valu_cs(&[
+        vop1(0x001, 0, vgpr(3)), // the old destination is the addend
+        (0x06 << 25) | (2 << 9) | u32::from(vgpr(1)),
+    ]);
+    [("mad", mad), ("mac", mac)]
+}
+
+#[test]
+fn legacy_fma_rounding_on_hardware() {
+    // WARP may implement dx.op.tertiary.f32(46) with two roundings; it is
+    // not a reference for this hardware precision requirement.
+    if std::env::var("VICTORY_WARP").is_ok_and(|v| v == "1")
+        || Host::new(false).is_err()
+    {
+        eprintln!("legacy FMA precision: no hardware probe executed");
+        return;
+    }
+    let cases = [
+        [0x3f80_0001, 0x3f7f_fffe, 0xbf80_0000, 0],
+        [0x3f80_0001, 0x3f80_0001, 0xbf80_0002, 0],
+    ];
+    // Cancellation leaves -/+2^-46 only with a single rounding.
+    let expected = [0xa880_0000, 0x2880_0000];
+    let mut executed = 0;
+    for (name, shader) in legacy_fma_programs() {
+        run_cases_on(&shader, &cases, &[("hardware", false)], |backend, i, _, got| {
+            assert_eq!(got, expected[i], "{backend}: legacy {name} fused case {i}");
+            executed += 1;
+        });
+    }
+    assert_eq!(executed, 4, "the hardware precision cases must actually run");
+    eprintln!("legacy FMA precision: {executed} hardware cases executed");
+}
+
+#[test]
+fn legacy_fma_zero_factor_accumulator_and_modifiers() {
+    let cases = [
+        [0, 0x7f80_0000, 0x3f80_0000, 0], // zero * infinity + 1
+        [0x8000_0000, 0x7fc0_1234, 0x8000_0000, 0], // -0 * NaN + -0
+        [0x7fc0_1234, 0x8000_0000, 0xc000_0000, 0], // NaN * -0 - 2
+        [0x7f80_0000, 0, 0x7fc0_4321, 0], // zero product does not hide NaN addend
+        [0x4000_0000, 0x4040_0000, 0x4080_0000, 0], // 2 * 3 + 4
+        [0x7f80_0000, 0x3f80_0000, 0xff80_0000, 0], // infinity - infinity
+    ];
+    let expected = [Some(0x3f80_0000), Some(0), Some(0xc000_0000), None, Some(0x4120_0000), None];
+    for (name, shader) in legacy_fma_programs() {
+        run_cases(&shader, &cases, |backend, i, _, got| {
+            if let Some(want) = expected[i] {
+                assert_eq!(got, want, "{backend}: legacy {name} case {i}");
+            } else {
+                assert!(f32::from_bits(got).is_nan(), "{backend}: legacy {name} case {i}: {got:#x}");
+            }
+        });
+    }
+    let modifiers = [0xc000_0000, 0x4040_0000, 0x4080_0000, 0];
+    for (clamp, expected) in [(false, 0xc080_0000), (true, 0)] {
+        // (abs(-2) * -3 + 4) * 2 = -4, then optional output clamp.
+        let shader = build_valu_cs(&vop3_mod(0x140, 0, vgpr(1), vgpr(2), vgpr(3), 1, 2, 1, clamp));
+        run_cases(&shader, &[modifiers], |backend, _, _, got| {
+            assert_eq!(got, expected, "{backend}: legacy FMA modifiers, clamp={clamp}");
+        });
+    }
+}
