+    /// A buffer's size query uses its own handle. The Radeon compiler can
+    /// crash when a uniform heap handle serves both GetDimensions and a
+    /// buffer load, including DXC-generated programs. Reading each lane's
+    /// own index keeps the query's handle separate without changing which
+    /// descriptor it addresses. Helper pixels retain their original index:
+    /// wave reads do not include them.
+    fn buffer_query_handle(
+        &mut self,
+        load: Site,
+        first: u8,
+        props: (u32, u32),
+    ) -> Result<V, Why> {
+        let src = Source::Loaded { load, first };
+        let index = self.heap_index(load, first, false)?;
+        let (mut index, mut bounded) = self.raw_twin(&src, index, false, props);
+        let c = self.cur;
+        let i32t = self.s.t.i32;
+        // Apply the same null-slot bound as heap_handle_at before the
+        // identity operation, including when this is not a raw twin.
+        let limit = super::shader::view_heap_limit();
+        if !bounded && limit != 0 {
+            let last = self.s.m.i32(limit);
+            index = self.s.op(c, "binary.i32", Attr::ReadNone, i32t, 40, &[index, last]);
+            self.s.m.tag(index, Tag::Clamp);
+            bounded = true;
+        }
+        self.s.flags |= flags::WAVE_OPS;
+        let lane = self.s.op(c, "waveGetLaneIndex", Attr::ReadOnly, i32t, 111, &[]);
+        let own = self.read_lane(index, lane);
+        let index = if self.s.pixel {
+            let helper = self.helper_lane();
+            self.s.m.select(c, helper, index, own)
+        } else {
+            own
+        };
+        Ok(self.s.heap_handle_at(c, index, false, true, props, bounded))
+    }
