+/// Querying a raw twin must count that view, not the title's original
+/// slot. Both the query and load retain the runtime's twin mapping.
+#[test]
+fn a_table_buffer_query_uses_the_same_raw_twin_as_its_load() {
+    let load = [
+        0x7E06_0280, // v_mov_b32 v3, 0
+        0xE030_2000, // buffer_load_dword v5, v3, s[8:11], 0 idxen
+        0x8002_0503,
+        0x7E0A_0505, // v_readfirstlane_b32 s5, v5
+    ];
+    let words = [TABLE, COUNT, &load, STORE].concat();
+    super::shader::RAW_VIEWS_HERE.set(Some(4));
+    let result = build(&words, (4, 16));
+    super::shader::RAW_VIEWS_HERE.set(None);
+    let shader = result.expect("translates");
+    let (mut title, mut twin, texel) = ([0u32; 12], [0u32; 20], [[0.0; 4]; 1]);
+    title[0] = 77;
+    twin[0] = 99;
+    let raw = |data| View::Buffer { data, stride: Stride::Raw };
+    let other = || View::Texture(1, 1, &texel);
+    let views = [raw(&title), other(), other(), other(), raw(&twin), other(), View::RawUav(2)];
+    for (label, got) in run(&shader, &views) {
+        assert_eq!(got[..2], [5, 99], "{label}");
+    }
+}
+
+/// A UAV can be counted, read and written through the same descriptor.
+/// Its size remains bytes and its query does not alias the load's handle.
+#[test]
+fn a_raw_uav_can_be_queried_and_loaded() {
+    let body = [
+        0x7E04_02FF, // v_mov_b32 v2, 77
+        77,
+        0xE070_0008, // buffer_store_dword v2, off, s[20:23], 0 offset:8
+        0x8005_0200,
+        0xE030_0008, // buffer_load_dword v3, off, s[20:23], 0 offset:8
+        0x8005_0300,
+        0x7E0A_0503, // v_readfirstlane_b32 s5, v3
+        0xBE84_0316, // s_mov_b32 s4, s22 (byte count)
+    ];
+    let shader = build(&[TABLE, &body, STORE].concat(), (8, 0)).expect("translates");
+    let texel = [[0.0; 4]; 1];
+    let views = [View::Texture(1, 1, &texel), View::Texture(1, 1, &texel), View::RawUav(3)];
+    for (label, got) in run(&shader, &views) {
+        assert_eq!(got[..3], [12, 77, 77], "{label}");
+    }
+}
