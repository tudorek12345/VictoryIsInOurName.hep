+/// Counts owning containers, not draw-order entries (which can name one
+/// list repeatedly). Limit the work done while the owner lock is held.
+#[cfg(feature = "diagnostics")]
+fn owner_counts(sizes: impl IntoIterator<Item = usize>) -> Option<(u64, u64)> {
+    let mut count = (0u64, 0u64);
+    for size in sizes.into_iter().take(4097) {
+        count.0 += 1;
+        if count.0 > 4096 {
+            return None;
+        }
+        count.1 = count.1.checked_add(size as u64)?;
+    }
+    Some(count)
+}
+
+/// Read-only ownership census. These buckets are not an exhaustive partition:
+/// recordings, queued CPU work and lists being recycled also own references.
+/// While flights are being landed outside LINE, in-flight totals are unknown.
+/// No GPU call, resource traversal, lifetime change or blocking lock occurs.
+#[cfg(feature = "diagnostics")]
+pub(crate) fn sampled_ownership() -> OwnershipSample {
+    let mut sample = OwnershipSample::default();
+    if let Some((pending, landed, settling)) = try_memory_snapshot(&LINE, |line| {
+        let pending = if !line.settling && line.line.len() <= 4096 {
+            owner_counts(line.line.iter().filter_map(|item| match item {
+                Late::Run(flight) => Some(flight.lists.len()),
+                _ => None,
+            }))
+        } else {
+            None
+        };
+        let landed = owner_counts(line.landed.iter().map(|(lists, _)| lists.len()));
+        (pending, landed, line.settling)
+    }) {
+        sample.inflight_flights = pending.map(|c| c.0);
+        sample.inflight_lists = pending.map(|c| c.1);
+        sample.landed_flights = landed.map(|c| c.0);
+        sample.landed_lists = landed.map(|c| c.1);
+        sample.landing_active = Some(settling);
+    }
+    if let Some((all, resources, front, back)) = try_memory_snapshot(&RETIRED, |retired| {
+        (retired.len() as u64, RETIRED_RESOURCES.load(Ordering::Relaxed),
+         retired.front().map(|(at, _)| *at), retired.back().map(|(at, _)| *at))
+    }) {
+        sample.retired_objects = Some(all);
+        sample.retired_resources = Some(resources);
+        sample.retired_any = all.checked_sub(resources);
+        sample.retired_front_submission = front;
+        sample.retired_back_submission = back;
+    }
+    sample
+}
