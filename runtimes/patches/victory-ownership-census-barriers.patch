+/// Several shadows can name the same host buffer. All their copies still
+/// run, but that resource leaves COPY_DEST only once before the passes.
+/// Adapted from avatarmanz/VIctory-7900XTX 773d902f16d523c431925a319d6b430dedcba157.
+fn copied_buffer_transition(
+    resource: &ID3D12Resource,
+    transitioned: &mut Vec<*mut std::ffi::c_void>,
+) -> Option<D3D12_RESOURCE_BARRIER> {
+    let raw = resource.as_raw();
+    if transitioned.contains(&raw) {
+        return None;
+    }
+    transitioned.push(raw);
+    Some(transition(resource, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE))
+}
