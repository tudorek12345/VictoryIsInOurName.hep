+/// A failed or poisoned try-lock is unknown, never a zero-sized owner.
+/// Called only by the independent memory sampler; no waiting or recovery.
+#[cfg(feature = "diagnostics")]
+pub(crate) fn try_memory_snapshot<T, R>(lock: &Mutex<T>, read: impl FnOnce(&T) -> R) -> Option<R> {
+    lock.try_lock().ok().map(|value| read(&value))
+}
