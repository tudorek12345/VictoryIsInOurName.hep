+#[cfg(all(test, feature = "diagnostics"))]
+mod ownership_sample_tests {
+    use super::{owner_counts, try_memory_snapshot};
+    use std::sync::{Arc, Mutex};
+
+    #[test]
+    fn a_busy_owner_is_unknown_and_sampling_does_not_release_it() {
+        let resource = Arc::new(17);
+        let owner = Mutex::new(vec![resource.clone()]);
+        let held = owner.lock().unwrap();
+        assert_eq!(try_memory_snapshot(&owner, Vec::len), None);
+        assert_eq!(Arc::strong_count(&resource), 2);
+        drop(held);
+        assert_eq!(try_memory_snapshot(&owner, Vec::len), Some(1));
+        assert_eq!(Arc::strong_count(&resource), 2);
+        assert_eq!(**owner.lock().unwrap().first().unwrap(), 17);
+    }
+
+    #[test]
+    fn owner_counts_include_all_lists_in_each_flight_and_bound_sampling_work() {
+        assert_eq!(owner_counts([2, 0, 7]), Some((3, 9)));
+        assert_eq!(owner_counts([]), Some((0, 0)));
+        assert_eq!(owner_counts(std::iter::repeat(1).take(4096)), Some((4096, 4096)));
+        // An infinite source must not turn the sampler into a blocking walk.
+        assert_eq!(owner_counts(std::iter::repeat(1)), None);
+    }
+}
