+#[cfg(test)]
+mod copied_buffer_transition_tests {
+    use super::*;
+
+    #[test]
+    fn copied_aliases_have_one_transition_per_host_buffer() {
+        // Authored resources only, on the verified software adapter. No
+        // command queue is created and no GPU work is submitted.
+        let adapter = warp_adapter().expect("software WARP adapter");
+        let mut device: Option<ID3D12Device> = None;
+        // SAFETY: the adapter and output pointer are live.
+        unsafe { D3D12CreateDevice(&adapter, D3D_FEATURE_LEVEL_12_0, &mut device) }.unwrap();
+        let device = device.unwrap();
+        let make_buffer = || {
+            let heap = D3D12_HEAP_PROPERTIES { Type: D3D12_HEAP_TYPE_DEFAULT, ..Default::default() };
+            let desc = D3D12_RESOURCE_DESC {
+                Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+                Width: 4096,
+                Height: 1,
+                DepthOrArraySize: 1,
+                MipLevels: 1,
+                SampleDesc: windows::Win32::Graphics::Dxgi::Common::DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+                Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+                ..Default::default()
+            };
+            let mut resource: Option<ID3D12Resource> = None;
+            // SAFETY: a complete small buffer description and live output.
+            unsafe {
+                device.CreateCommittedResource(
+                    &heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST, None, &mut resource,
+                )
+            }.unwrap();
+            resource.unwrap()
+        };
+        let first = make_buffer();
+        let alias = first.clone();
+        let second = make_buffer();
+        let mut transitioned = Vec::new();
+        let planned: Vec<_> = [&first, &alias, &second, &first].into_iter()
+            .filter_map(|resource| copied_buffer_transition(resource, &mut transitioned)).collect();
+        assert_eq!(planned.len(), 2);
+        for (barrier, resource) in planned.iter().zip([&first, &second]) {
+            assert_eq!(barrier.Type, D3D12_RESOURCE_BARRIER_TYPE_TRANSITION);
+            // SAFETY: the production helper constructed transition barriers;
+            // the three resource handles remain alive for this assertion.
+            let planned = unsafe { &barrier.Anonymous.Transition };
+            assert_eq!(planned.pResource.as_ref().unwrap().as_raw(), resource.as_raw());
+            assert_eq!(planned.Subresource, D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES);
+            assert_eq!(planned.StateBefore, D3D12_RESOURCE_STATE_COPY_DEST);
+            assert_eq!(planned.StateAfter, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        }
+    }
+}
